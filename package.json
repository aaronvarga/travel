{
  "name": "travel",
  "version": "1.0.0",
  "description": "",
  "main": "index.js",
  "scripts": {
    "extract": "node tools/extract.mjs",
    "lint": "node tools/lint-sections.mjs",
    "summary": "node tools/build-summary.mjs",
    "verify-summary": "node tools/verify-summary.mjs",
    "build": "node tools/lint-sections.mjs && node tools/validate-scorecards.mjs && node tools/validate-evidence.mjs && node tools/reconcile-budgets.mjs --strict && node tools/build-summary.mjs && node tools/analyze-rank-stability.mjs && node tools/composer/compose.mjs && node tools/composer/validate-combos.mjs && node tools/optimize-images.mjs && node ./node_modules/@11ty/eleventy/cmd.cjs && node tools/verify-summary.mjs --site && node tools/audit-performance.mjs",
    "serve": "node ./node_modules/@11ty/eleventy/cmd.cjs --serve",
    "test": "node --test tools/test/*.test.mjs",
    "validate:evidence": "node tools/validate-evidence.mjs",
    "derive:evidence-confidence": "node tools/update-evidence-confidence.mjs",
    "report:evidence-confidence": "node tools/report-evidence-confidence.mjs",
    "reconcile:budgets": "node tools/reconcile-budgets.mjs",
    "analyze:rank": "node tools/analyze-rank-stability.mjs",
    "optimize:images": "node tools/optimize-images.mjs",
    "test:performance": "node tools/optimize-images.mjs --check && node tools/audit-performance.mjs",
    "sync": "node tools/sync-site.mjs",
    "sync:check": "node tools/sync-site.mjs --check",
    "import": "node tools/extract.mjs",
    "alltrails": "node tools/apply-alltrails.mjs",
    "extract:leg": "node tools/composer/extract-legs.mjs",
    "validate:legs": "node tools/composer/validate-legs.mjs",
    "compose": "node tools/composer/compose.mjs",
    "validate:combos": "node tools/composer/validate-combos.mjs"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/aaronvarga/travel.git"
  },
