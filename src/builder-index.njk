<!doctype html><html lang="en"><head><meta charset="utf-8"><meta name="viewport" content="width=device-width,initial-scale=1"><title>Trip Builder</title><style>
:root{--ink:#1a1712;--muted:#6b645a;--paper:#f6f1e7;--card:#fffdf8;--line:rgba(26,23,18,.14);--teal:#1f6f78;--rust:#c25a3a}*{box-sizing:border-box}body{margin:0;background:var(--paper);color:var(--ink);font:16px/1.5 system-ui,sans-serif}.builder-shell{max-width:1180px;margin:auto;padding:28px 20px 60px}h1,h2,h3{font-family:Georgia,serif}.builder-hero{padding:34px;border-radius:20px;background:linear-gradient(135deg,#17130f,#244d53);color:#fff}.builder-hero a{color:#bfe4e8}.builder-hero h1{font-size:clamp(2.4rem,6vw,4.7rem);line-height:.95;margin:12px 0}.builder-hero p{max-width:720px}.builder-controls{margin:28px 0}.builder-chips{display:flex;flex-wrap:wrap;gap:8px}.builder-chip{border:1px solid var(--line);border-radius:999px;background:#fff;padding:9px 14px;font-weight:750;cursor:pointer}.builder-chip[aria-pressed="true"]{background:var(--teal);color:#fff}.builder-status{color:var(--muted)}.builder-grid{display:grid;grid-template-columns:repeat(auto-fit,minmax(260px,1fr));gap:14px}.builder-card{display:flex;flex-direction:column;padding:18px;border:1px solid var(--line);border-radius:16px;background:var(--card);box-shadow:0 12px 30px rgba(30,32,28,.08)}.builder-card[hidden]{display:none}.builder-card h2{margin:0 0 8px;font-size:1.35rem}.builder-card p{color:var(--muted)}.builder-metrics{display:flex;flex-wrap:wrap;gap:6px;margin:auto 0 14px}.builder-metrics span{padding:5px 8px;border-radius:999px;background:#edf5f2;color:#255b5d;font-size:.76rem;font-weight:800}.builder-card a{display:block;padding:10px 12px;border-radius:9px;background:var(--rust);color:#fff;text-align:center;text-decoration:none;font-weight:800}
</style></head><body><main class="builder-shell"><header class="builder-hero"><a href="../../index.html">← Family Trip Dashboard</a><p>Build-time Trip Composer</p><h1>Trip Builder</h1><p>Choose a starting destination, see compatible second legs, and open a complete static draft with dates, transfer logic, estimated budget, and a provisional /50 score.</p></header>
<section class="builder-controls" aria-labelledby="starts-heading"><h2 id="starts-heading">Start destination</h2><div class="builder-chips"><button class="builder-chip" type="button" data-start="all" aria-pressed="true">All</button>{% for start in composer.combosStarts %}<button class="builder-chip" type="button" data-start="{{ start.id }}" aria-pressed="false">{{ start.name }}</button>{% endfor %}</div><p class="builder-status" aria-live="polite">Showing all {{ composer.combosIndex | length }} composed drafts.</p></section>
<section class="builder-grid" aria-label="Composed trip drafts">{% for item in composer.combosIndex %}<article class="builder-card" data-start="{{ item.startId }}" data-partner="{{ item.partnerId }}"><h2>{{ item.startName }} + {{ item.partnerName }}</h2><p>Composed review draft with a {{ item.transferRisk }}/5 transfer-risk estimate.</p><div class="builder-metrics"><span>Est. {{ item.score }}/50</span><span>${{ item.budget.floorUsd }}–${{ item.budget.ceilUsd }}</span><span>{{ item.totalNights }} nights</span><span>Risk {{ item.transferRisk }}/5</span></div><a href="../{{ item.slug }}/">Open composed itinerary</a></article>{% endfor %}</section>
<script type="application/json" id="builder-data">{{ composer.combosIndex | jsonForScript | safe }}</script><script src="../../assets/js/builder.js?v=20260712-composer" defer></script></main></body></html>
