<!doctype html><html lang="en"><head><meta charset="utf-8"><meta name="viewport" content="width=device-width,initial-scale=1"><link rel="preconnect" href="https://fonts.googleapis.com"><link rel="preconnect" href="https://fonts.gstatic.com" crossorigin><link href="https://fonts.googleapis.com/css2?family=Spectral:wght@400;600;700&family=Source+Sans+3:wght@400;500;600;700&display=swap" rel="stylesheet"><title>Trip Builder</title><style>
:root{--ink:#1a1712;--muted:#6b645a;--paper:#efe8da;--card:#fff;--line:rgba(26,23,18,.14);--teal:#1a4a3c;--rust:#c04a2f}*{box-sizing:border-box}body{margin:0;background:var(--paper);color:var(--ink);font:16px/1.5 "Source Sans 3",system-ui,sans-serif}.builder-shell{max-width:1180px;margin:auto;padding:28px 20px 60px}.builder-hero{padding:34px;border-radius:20px;background:linear-gradient(135deg,#17130f,#244d53);color:#fff}.builder-hero a{color:#bfe4e8}.builder-hero h1{font-family:"Spectral",Georgia,serif;font-size:clamp(2.4rem,6vw,4.7rem);line-height:.95;margin:12px 0}.builder-hero p{max-width:720px}.builder-controls{margin:28px 0}.builder-controls h2{font-family:"Spectral",Georgia,serif}.builder-chips{display:flex;flex-wrap:wrap;gap:8px}.builder-chip{border:1px solid var(--line);border-radius:999px;background:#fff;padding:9px 14px;font:700 .9rem "Source Sans 3",sans-serif;cursor:pointer}.builder-chip[aria-pressed="true"]{background:var(--teal);color:#fff}.builder-status{color:var(--muted)}.sl-grid{display:grid;grid-template-columns:repeat(auto-fit,minmax(300px,1fr));gap:22px}.sl-card{background:#fff;border-radius:14px;overflow:hidden;box-shadow:0 1px 2px rgba(40,50,40,.05),0 6px 16px rgba(40,50,40,.06);display:flex;flex-direction:column;text-decoration:none;color:inherit;transition:transform .15s ease,box-shadow .15s ease}.sl-card:hover{transform:translateY(-3px);box-shadow:0 4px 10px rgba(40,50,40,.09),0 16px 34px rgba(40,50,40,.14)}.builder-card[hidden]{display:none}.sl-photo{position:relative;height:170px;background:#d8d2c4}.sl-photo img{width:100%;height:100%;object-fit:cover;display:block}.sl-rank{position:absolute;top:9px;left:9px;min-width:28px;height:28px;padding:0 8px;border-radius:999px;background:#9a6a17;color:#fff;font-weight:700;font-size:10px;letter-spacing:.06em;display:flex;align-items:center;justify-content:center;box-shadow:0 1px 4px rgba(0,0,0,.3);z-index:2}.sl-body{padding:13px 15px 15px;display:flex;flex-direction:column;gap:7px;flex:1}.sl-meta{display:flex;align-items:baseline;justify-content:space-between;gap:8px}.sl-dates{font-weight:700;font-size:11px;letter-spacing:.06em;color:#2f6b52;text-transform:uppercase}.sl-pto{font-weight:700;font-size:11px;letter-spacing:.06em;color:#8a8f85;text-transform:uppercase;white-space:nowrap;text-align:right}.sl-score{display:inline-flex;align-items:center;gap:4px;min-width:68px;padding:4px 9px 4px 10px;border-radius:999px;background:#1a4a3c;color:#fff;box-shadow:0 2px 7px rgba(26,74,60,.24);font-variant-numeric:tabular-nums;line-height:1}.sl-score b{font-family:"Spectral",Georgia,serif;font-size:21px;font-weight:700;letter-spacing:-.04em}.sl-score>span{display:flex;flex-direction:column;gap:1px;color:rgba(255,255,255,.9);font-size:9px;font-weight:700}.sl-score small{color:rgba(255,255,255,.68);font-size:7px;letter-spacing:.08em;text-transform:uppercase}.sl-titlerow{display:flex;align-items:baseline;gap:9px}.sl-titlerow h3{font-family:"Spectral",Georgia,serif;font-weight:700;font-size:20px;line-height:1.15;margin:0;color:#1c2620;flex:1}.sl-nights{display:inline-flex;align-items:center;gap:4px;background:#eef3ee;border:1px solid #dbe6dd;border-radius:999px;padding:3px 9px;white-space:nowrap}.sl-nights b{font-family:"Spectral",Georgia,serif;font-size:14px;color:#1a4a3c}.sl-nights i{font-style:normal;font-size:9.5px;font-weight:600;letter-spacing:.04em;color:#5b7a6b;text-transform:uppercase}.sl-desc{margin:0;font-size:12.5px;line-height:1.5;color:#5b625a}.sl-div{height:1px;background:#ece5d7;margin:1px 0}.sl-logi{display:grid;grid-template-columns:minmax(0,1.7fr) minmax(0,1fr);gap:5px 12px;font-size:11px;line-height:1.35;color:#4a5149}.sl-logi .lbl,.sl-readiness .lbl{color:#a29a88;font-weight:600;text-transform:uppercase;letter-spacing:.04em;font-size:9px}.sl-budget-pill{display:inline-flex;align-items:center;margin-top:3px;padding:4px 8px;border:1px solid transparent;border-radius:999px;font-weight:700;line-height:1;white-space:nowrap}.sl-budget-pill.within-preference{background:#fff0c9;border-color:#ead38d;color:#7a5715}.sl-budget-pill.over-preference{background:#f6e2c9;border-color:#e6bd82;color:#965716}.sl-tags{display:flex;flex-wrap:wrap;gap:5px;margin-top:1px}.sl-tags span{font-size:10px;font-weight:600;color:#2f6b52;background:#e6efe8;border-radius:5px;padding:2px 7px}.sl-readiness{display:grid;gap:2px;margin-top:2px;padding-top:7px;border-top:1px solid #ece5d7;color:#4a5149;font-size:11px;line-height:1.35}
</style></head><body><main class="builder-shell"><header class="builder-hero"><a href="../../index.html">← Family Trip Dashboard</a><p>Build-time Trip Composer</p><h1>Trip Builder</h1><p>Choose a starting destination, see compatible second legs, and open a complete static draft with dates, transfer logic, estimated budget, and a provisional /50 score.</p></header>
<section class="builder-controls" aria-labelledby="starts-heading"><h2 id="starts-heading">Start destination</h2><div class="builder-chips"><button class="builder-chip" type="button" data-start="all" aria-pressed="true">All</button>{% for start in composer.combosStarts %}<button class="builder-chip" type="button" data-start="{{ start.id }}" aria-pressed="false">{{ start.name }}</button>{% endfor %}</div><p class="builder-status" aria-live="polite">Showing all {{ composer.combosIndex | length }} composed drafts.</p></section>
<section class="sl-grid builder-grid" aria-label="Composed trip drafts">{% for item in composer.combosIndex %}<a class="sl-card builder-card" data-start="{{ item.startId }}" data-partner="{{ item.partnerId }}" href="../{{ item.slug }}/"><div class="sl-photo"><img src="{{ item.heroImage | safe }}" alt="{{ item.heroAlt | safe }}" loading="lazy"><div class="sl-rank">EST</div></div><div class="sl-body"><div class="sl-meta"><span class="sl-dates">{{ item.departDate | displayDate }}–{{ item.returnDate | displayDate }}</span><span class="sl-score" aria-label="Estimated {{ item.score }} out of 50"><b>{{ item.score }}</b><span>/50<small>estimated</small></span></span><span class="sl-pto">{{ item.ptoDays }} PTO</span></div><div class="sl-titlerow"><h3>{{ item.startName }} + {{ item.partnerName }}</h3><span class="sl-nights"><b>{{ item.totalNights }}</b><i>nights</i></span></div><p class="sl-desc">Composed review draft joining two reviewed destination legs with an estimated {{ item.transferRisk }}/5 transfer-risk rating.</p><div class="sl-div"></div><div class="sl-logi"><div><span class="lbl">Budget</span><br><span class="sl-budget-pill {% if item.budget.ceilUsd <= 15000 %}within-preference{% else %}over-preference{% endif %}">${{ (item.budget.floorUsd / 1000) | round(1) }}k–${{ (item.budget.ceilUsd / 1000) | round(1) }}k</span></div><div><span class="lbl">Evidence</span><br>Not audited</div></div><div class="sl-tags"><span>Estimated score</span><span>Risk {{ item.transferRisk }}/5</span></div><div class="sl-readiness"><span class="lbl">Readiness</span><span>Combination audit required</span></div></div></a>{% endfor %}</section>
<script type="application/json" id="builder-data">{{ composer.combosIndex | jsonForScript | safe }}</script><script src="../../assets/js/builder.js?v=20260712-composer" defer></script></main></body></html>
