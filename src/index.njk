.trip-card[data-trip="portugal"] .trip-topline span{color:#236b4d}
.trip-card[data-trip="portugal-sicily"],.trip-card[data-trip="portugal-crete"]{border-color:#5aa9c2;border-top:6px solid #2f8f65;box-shadow:0 18px 44px rgba(47,143,101,.16)}
.trip-card[data-trip="portugal-sicily"] .rank,.trip-card[data-trip="portugal-crete"] .rank{background:#2f8f65;color:#fff}
.trip-card.is-picked{border-color:#c25a3a;border-top:6px solid #c25a3a;box-shadow:0 18px 44px rgba(194,90,58,.28);transform:translateY(-2px)}
