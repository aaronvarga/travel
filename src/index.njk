@media(max-width:640px){.flight-legend{display:grid;gap:6px}.flight-legend span{border-radius:10px}.flight-table-wrap{margin:0 -2px}.flight-table{font-size:.82rem}.flight-table th,.flight-table td{padding:12px 10px}}
