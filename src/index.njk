---
permalink: "/index.html"
---
<!doctype html>
<html lang="en">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Spectral:wght@400;600;700&family=Source+Sans+3:wght@400;500;600;700&display=swap" rel="stylesheet">
<title>Family Trip Decision Dashboard - 30-Trip Comparison</title>
<style>
:root{color-scheme:light;--ink:#1a1712;--muted:#6b645a;--paper:#f6f1e7;--card:#fffdf8;
 --line:rgba(26,23,18,.12);--c1:#1f6f78;--c2:#c25a3a;--c3:#3f7d4e;--gold:#d9a441;
 --save:#3f7d4e;--splurge:#a9862b;--shadow:0 18px 46px rgba(30,32,28,.14)}
*{box-sizing:border-box}
html{scroll-behavior:smooth}
body{margin:0;background:var(--paper);color:var(--ink);
 font:16px/1.55 "Inter",ui-sans-serif,system-ui,-apple-system,"Segoe UI",sans-serif;-webkit-font-smoothing:antialiased}
h1,h2,h3,h4{font-family:"Fraunces","Georgia",serif;letter-spacing:-.01em}
a{color:var(--c1)}
.eyebrow{margin:0 0 8px;color:var(--c2);font-size:.72rem;font-weight:800;letter-spacing:.14em;text-transform:uppercase}
/* HERO */
header{position:relative;isolation:isolate;min-height:clamp(380px,62vh,640px);display:grid;align-items:end;padding:32px clamp(20px,5vw,80px) 42px;color:#fff;overflow:hidden;background:linear-gradient(90deg,#17130f 0%,#17130f 30%,#3b2419 64%,#6c3f25 100%)}
header::before{content:"";position:absolute;top:0;right:-2vw;bottom:0;width:min(72vw,1160px);background:url("assets/family-cartoon.png") center / cover no-repeat;z-index:0;-webkit-mask-image:linear-gradient(90deg,transparent 0%,rgba(0,0,0,.14) 7%,rgba(0,0,0,.58) 17%,#000 30%);mask-image:linear-gradient(90deg,transparent 0%,rgba(0,0,0,.14) 7%,rgba(0,0,0,.58) 17%,#000 30%)}
header::after{content:"";position:absolute;inset:0;background:linear-gradient(90deg,rgba(18,16,12,.99) 0%,rgba(18,16,12,.96) 29%,rgba(18,16,12,.78) 42%,rgba(18,16,12,.38) 57%,rgba(18,16,12,.1) 72%,rgba(18,16,12,.27) 100%),linear-gradient(180deg,rgba(10,20,24,.02),rgba(10,18,22,.12) 45%,rgba(8,14,18,.72));z-index:0}
.hero-inner{max-width:700px}
.hero-inner{position:relative;z-index:1}
header .kicker{display:inline-flex;gap:10px;align-items:center;margin:0 0 20px;padding:7px 15px;border:1px solid rgba(255,255,255,.4);border-radius:999px;font-size:.74rem;font-weight:700;letter-spacing:.12em;text-transform:uppercase;backdrop-filter:blur(6px);background:rgba(255,255,255,.08)}
h1{max-width:660px;margin:0 0 16px;font-size:clamp(2.55rem,4.85vw,4.35rem);line-height:.95;font-weight:600;text-shadow:0 2px 30px rgba(0,0,0,.35)}
header .lead{max-width:620px;margin:0 0 24px;font-size:clamp(1rem,1.35vw,1.08rem);color:rgba(255,255,255,.94);line-height:1.48}
.hero-meta{display:flex;flex-wrap:wrap;gap:26px}
.hero-meta div{display:flex;flex-direction:column}
.hero-meta b{font-family:"Fraunces",serif;font-size:1.5rem;line-height:1}
.hero-meta span{font-size:.72rem;letter-spacing:.1em;text-transform:uppercase;color:rgba(255,255,255,.75);margin-top:4px}
/* NAV */
section[id],article[id]{scroll-margin-top:84px}
.site-nav{z-index:500;--nav-bg:#17130f;--nav-panel:#211c16;--nav-panel-2:#2a231b;--nav-line:rgba(246,241,231,.16);--nav-text:#f6f1e7;--nav-muted:rgba(246,241,231,.62);--nav-active:#5f9aa3;--nav-active-ink:#061517;--nav-shadow:0 18px 42px rgba(12,10,8,.28)}
.site-nav summary{list-style:none}
.site-nav summary::-webkit-details-marker{display:none}
.site-nav a{color:var(--nav-text);font-weight:800;text-decoration:none;line-height:1.2;transition:background .15s,color .15s,border-color .15s,box-shadow .15s}
.site-nav a.active{background:var(--nav-active);color:var(--nav-active-ink);border-color:var(--nav-active);box-shadow:0 8px 22px rgba(95,154,163,.22)}
@media(min-width:960px){
  body{padding-left:clamp(210px,17vw,248px)}
  section[id],article[id]{scroll-margin-top:24px}
  .site-nav{position:fixed;inset:0 auto 0 0;width:clamp(210px,17vw,248px);display:block;padding:18px 14px;background:linear-gradient(180deg,rgba(33,28,22,.98),rgba(18,15,12,.97));border-right:1px solid var(--nav-line);backdrop-filter:blur(16px);box-shadow:14px 0 42px rgba(12,10,8,.26);overflow:hidden;color:var(--nav-text)}
  .site-nav-menu{height:100%;display:flex;flex-direction:column;min-height:0;overflow:hidden}
  .site-nav summary{display:flex;align-items:center;justify-content:space-between;gap:10px;margin:0 0 12px;padding:10px 10px 13px;border-bottom:1px solid var(--nav-line);color:var(--nav-muted);font-size:.7rem;font-weight:900;letter-spacing:.14em;text-transform:uppercase;cursor:default}
  .site-nav summary::after{content:"";width:26px;height:2px;background:var(--nav-line)}
  .site-nav-links{flex:1 1 auto;display:grid;align-content:start;gap:6px;overflow-y:auto;overscroll-behavior:contain;-webkit-overflow-scrolling:touch;min-height:0;max-height:calc(100vh - 92px);padding:2px 2px 16px;scrollbar-width:thin;scrollbar-color:rgba(246,241,231,.26) transparent}
  .site-nav a{display:flex;align-items:center;min-height:36px;padding:8px 10px;border:1px solid transparent;border-radius:8px;background:transparent;font-size:.82rem}
  .site-nav a:hover{background:rgba(246,241,231,.1);color:#fff;border-color:var(--nav-line)}
  .site-nav a.nav-home{margin-bottom:6px;background:rgba(42,83,89,.42);color:var(--nav-active);border-color:rgba(95,154,163,.48)}
}
@media(max-width:959px){
  .site-nav{position:sticky;top:0;padding:10px clamp(14px,4vw,22px);background:rgba(23,19,15,.96);border-bottom:1px solid var(--nav-line);backdrop-filter:blur(14px);box-shadow:0 10px 28px rgba(12,10,8,.18)}
  .site-nav-menu{max-width:1180px;margin:0 auto}
  .site-nav summary{display:flex;align-items:center;justify-content:space-between;gap:14px;min-height:42px;padding:8px 12px;border:1px solid var(--nav-line);border-radius:10px;background:var(--nav-panel);box-shadow:0 8px 24px rgba(12,10,8,.22);color:var(--nav-text);font-size:.84rem;font-weight:900;cursor:pointer}
  .site-nav summary::after{content:"+";display:grid;place-items:center;width:24px;height:24px;border-radius:50%;background:var(--nav-active);color:var(--nav-active-ink);font-size:1rem;line-height:1}
  .site-nav-menu[open] summary{border-color:rgba(95,154,163,.55)}
  .site-nav-menu[open] summary::after{content:"-"}
  .site-nav-links{display:grid;grid-template-columns:repeat(auto-fit,minmax(145px,1fr));gap:7px;margin-top:8px;max-height:min(70vh,480px);overflow:auto;padding:8px;border:1px solid var(--nav-line);border-radius:12px;background:linear-gradient(180deg,var(--nav-panel),var(--nav-bg));box-shadow:0 18px 42px rgba(12,10,8,.34)}
  .site-nav a{display:flex;align-items:center;min-height:42px;padding:9px 10px;border:1px solid var(--nav-line);border-radius:8px;background:rgba(246,241,231,.06);font-size:.82rem}
  .site-nav a.nav-home,.site-nav a:hover{background:var(--nav-active);color:var(--nav-active-ink);border-color:var(--nav-active)}
}
main{max-width:1360px;margin:0 auto;padding:56px clamp(18px,5vw,60px) 40px}
.section-label{text-align:center;margin:0 auto 40px;max-width:760px}
.section-label h2{margin:.2em 0 .3em;font-size:clamp(1.9rem,4.4vw,3rem);font-weight:600}
.section-label p{margin:0;color:var(--muted)}
.divider{margin:78px 0 40px}
main>section{padding-top:52px;margin-top:4px;border-top:1px solid var(--line)}
main>section:first-of-type{border-top:0;padding-top:0;margin-top:0}
main>section>.eyebrow{margin-bottom:6px}
main>section>h2{margin:0 0 14px;max-width:820px}
main>section>h2+p{margin:0 0 30px;color:var(--muted);max-width:760px;font-size:1rem}
/* OVERVIEW */
.overview{display:grid;grid-template-columns:repeat(auto-fit,minmax(230px,1fr));gap:18px;margin-bottom:26px}
.ocard{background:var(--card);border:1px solid var(--line);border-radius:16px;padding:20px 22px;box-shadow:var(--shadow);display:flex;flex-direction:column;gap:5px}
.ocard b{font-family:"Fraunces","Georgia",serif;font-size:1.9rem;line-height:1.05;font-weight:600;color:var(--ink)}
.ocard span{color:var(--muted);font-size:.9rem;line-height:1.4}
.ocard .eyebrow{color:var(--c1)}
.ocard h4{margin:0 0 6px;font-size:1.4rem;font-weight:600}
.ocard p{margin:0;color:var(--muted);font-size:.92rem}
/* TRIP MAP */
.hc-grid{display:grid;grid-template-columns:repeat(auto-fit,minmax(300px,1fr));gap:18px}
.hc{background:var(--card);border:1px solid var(--line);border-radius:16px;padding:20px 22px;box-shadow:var(--shadow);border-top:4px solid var(--muted)}
.hc.act{border-top-color:#c0392b}
.hc.head{border-top-color:var(--gold)}
.hc.solid{border-top-color:var(--c3)}
.hc.fixed{border-top-color:var(--c1)}
.hc-tag{display:inline-block;font-size:.66rem;font-weight:800;letter-spacing:.08em;text-transform:uppercase;padding:3px 9px;border-radius:999px;margin-bottom:10px;color:#fff}
.hc.act .hc-tag{background:#c0392b}
.hc.head .hc-tag{background:var(--gold)}
.hc.solid .hc-tag{background:var(--c3)}
.hc.fixed .hc-tag{background:var(--c1)}
.hc h4{margin:0 0 8px;font-size:1.15rem;font-weight:600;line-height:1.15}
.hc p{margin:0;font-size:.9rem;color:var(--muted);line-height:1.5}
.hc p b{color:var(--ink)}

/* TRAVEL TIPS */
.tips-order{background:var(--card);border:1px solid var(--line);border-radius:16px;padding:18px 20px;box-shadow:var(--shadow);margin-bottom:22px}
.tips-order p.mini-h{margin:0 0 12px}
.tips-order ol{margin:0;padding:0;list-style:none;display:flex;flex-wrap:wrap;gap:8px;counter-reset:step}
.tips-order li{counter-increment:step;position:relative;background:var(--paper);border:1px solid var(--line);border-radius:999px;padding:7px 14px 7px 30px;font-size:.82rem;font-weight:600}
.tips-order li::before{content:counter(step);position:absolute;left:6px;top:50%;transform:translateY(-50%);width:18px;height:18px;border-radius:50%;background:var(--c1);color:#fff;font-size:.68rem;font-weight:800;display:grid;place-items:center}
.tips-order li span{color:var(--muted);font-weight:600}
.tips-grid{display:grid;grid-template-columns:repeat(auto-fit,minmax(340px,1fr));gap:18px}
.tipcard{background:var(--card);border:1px solid var(--line);border-radius:16px;padding:20px 22px;box-shadow:var(--shadow);border-top:4px solid var(--c1)}
.tipcard.t2{border-top-color:var(--c2)}.tipcard.t3{border-top-color:var(--gold)}.tipcard.t4{border-top-color:var(--c3)}
.tipcard h4{margin:0 0 4px;font-size:1.2rem;font-weight:600}
.tipcard .sub{margin:0 0 12px;font-size:.74rem;font-weight:700;letter-spacing:.04em;text-transform:uppercase;color:var(--muted)}
.tipcard ul{margin:0;padding:0;list-style:none;display:grid;gap:11px}
.tipcard li{font-size:.88rem;color:var(--muted);line-height:1.5;padding-left:16px;position:relative}
.tipcard li::before{content:"";position:absolute;left:0;top:8px;width:6px;height:6px;border-radius:50%;background:var(--gold)}
.tipcard li b{color:var(--ink)}
.tipcard li.flag::before{background:#c0392b;width:8px;height:8px;top:7px}
.tipcard li.flag b{color:#b5361f}

.daycost{display:inline-block;margin:8px 0 0;font-size:.76rem;font-weight:700;color:var(--c2);background:rgba(194,90,58,.1);border:1px solid rgba(194,90,58,.28);border-radius:999px;padding:3px 11px}
.budget-tbl.grand tr.total td{background:var(--ink);color:#fff;font-size:1.05rem;font-weight:800}
.rate-note{margin:12px 2px 0;font-size:.78rem;color:var(--muted);line-height:1.5}

.kv.climate{margin-top:10px;padding-top:10px;border-top:1px dashed var(--line)}
.kv.climate span{color:var(--c1)}

/* TIMING COMPARE */
.timing-compare{display:grid;grid-template-columns:repeat(auto-fit,minmax(280px,1fr));gap:18px;margin-bottom:22px}
.tcard{background:var(--card);border:1px solid var(--line);border-radius:16px;padding:20px 22px;box-shadow:var(--shadow);border-top:4px solid var(--muted)}
.tcard.now{border-top-color:var(--c1)}
.tcard.later{border-top-color:var(--c2)}
.tcard.best{border-top-color:var(--c3)}
.tcard.best .tlabel{background:var(--c3)}
.tcard .tlabel{display:inline-block;font-size:.7rem;font-weight:800;letter-spacing:.06em;text-transform:uppercase;padding:3px 10px;border-radius:999px;margin-bottom:10px;color:#fff}
.tcard.now .tlabel{background:var(--c1)}
.tcard.later .tlabel{background:var(--c2)}
.tcard h4{margin:0 0 12px;font-size:1.25rem;font-weight:600}
.tcard .trow{display:flex;justify-content:space-between;gap:14px;padding:7px 0;border-bottom:1px solid var(--line);font-size:.88rem}
.tcard .trow:last-child{border-bottom:0}
.tcard .trow span{color:var(--muted)}
.tcard .trow strong{text-align:right}
.tcard .trow strong.bad{color:#b5361f}
.listcard.pro-list{border-top:4px solid var(--c3)}
.listcard.con-list{border-top:4px solid #c0392b}
.listcard.pro-list li::before{content:"✓";position:static;width:auto;height:auto;border-radius:0;background:none;color:var(--c3);font-weight:800;margin-right:6px}
.listcard.con-list li::before{content:"✗";position:static;width:auto;height:auto;border-radius:0;background:none;color:#c0392b;font-weight:800;margin-right:6px}
.listcard.pro-list li,.listcard.con-list li{padding-left:0;display:flex;gap:2px}
.listcard.pro-list li>span,.listcard.con-list li>span{flex:1}
.verdict-box{background:var(--card);border:1px solid var(--line);border-left:5px solid var(--ink);border-radius:14px;padding:20px 22px;box-shadow:var(--shadow);margin-top:20px}
.verdict-box h4{margin:0 0 8px;font-size:1.1rem;font-weight:800}
.verdict-box p{margin:0 0 10px;font-size:.92rem;color:var(--muted);line-height:1.55}
.verdict-box p:last-child{margin-bottom:0}
.verdict-box .aside{font-size:.82rem;font-style:italic;border-top:1px dashed var(--line);padding-top:10px;margin-top:12px}

.tripmap-wrap{background:var(--card);border:1px solid var(--line);border-radius:20px;padding:14px;box-shadow:var(--shadow)}
.mapbtns{display:flex;flex-wrap:wrap;gap:8px;margin-bottom:12px}
.mapbtns button{border:1px solid var(--line);background:var(--paper);color:var(--ink);font-weight:700;font-size:.82rem;padding:7px 14px;border-radius:999px;cursor:pointer;transition:.15s}
.mapbtns button:hover{background:var(--ink);color:#fff}
.mapbtns button .sw{display:inline-block;width:9px;height:9px;border-radius:50%;margin-right:6px;vertical-align:middle}
#tripmap{height:460px;border-radius:14px;z-index:1}
.leaflet-popup-content{font:14px/1.4 "Inter",sans-serif}
.leaflet-popup-content b{font-family:"Fraunces",serif}
.pin{width:16px;height:16px;border-radius:50%;border:2.5px solid #fff;box-shadow:0 1px 5px rgba(0,0,0,.5)}
/* BASES */
.bases{display:grid;grid-template-columns:repeat(auto-fit,minmax(260px,1fr));gap:20px}
.base{position:relative;background:var(--card);border-radius:18px;overflow:hidden;box-shadow:var(--shadow);border:1px solid var(--line)}
.base .band{height:6px}
.base.b1 .band{background:var(--c1)}.base.b2 .band{background:var(--c2)}.base.b3 .band{background:var(--c3)}
.base .bimg{width:100%;aspect-ratio:16/10;object-fit:cover;display:block}
.base .bbody{padding:18px 20px 22px}
.base .nights{display:inline-block;padding:3px 10px;border-radius:999px;font-size:.72rem;font-weight:800;letter-spacing:.06em;color:#fff;margin-bottom:10px}
.base.b1 .nights{background:var(--c1)}.base.b2 .nights{background:var(--c2)}.base.b3 .nights{background:var(--c3)}
.base h4{margin:0 0 4px;font-size:1.55rem;font-weight:600}
.base .dates{margin:0 0 10px;color:var(--muted);font-size:.85rem;font-weight:600}
.base p{margin:0;color:var(--muted);font-size:.9rem}
.base .book{margin:12px 0 0;padding-top:12px;border-top:1px solid var(--line);font-size:.82rem;color:var(--ink)}
.base .book b{color:var(--c2)}
/* PLAN GRID */
.plan-grid{display:grid;grid-template-columns:1fr 1fr;gap:20px}
.pcard{background:var(--card);border:1px solid var(--line);border-radius:16px;padding:22px 24px;box-shadow:var(--shadow)}
.pcard h4{margin:0 0 14px;font-size:1.3rem;font-weight:600;display:flex;align-items:center;gap:10px}
.pcard h4 .dot{width:10px;height:10px;border-radius:50%;background:var(--gold)}
.prow{display:flex;justify-content:space-between;gap:16px;padding:8px 0;border-bottom:1px solid var(--line);font-size:.9rem}
.prow:last-of-type{border-bottom:0}
.prow span{color:var(--muted)}.prow strong{text-align:right}
.pcard .tip{margin:12px 0 0;padding:10px 12px;background:rgba(217,164,65,.12);border-radius:10px;font-size:.82rem;color:#8a6a1e}
/* DAYS */
.days{display:grid;gap:26px}
.day{background:var(--card);border:1px solid var(--line);border-radius:20px;overflow:hidden;box-shadow:var(--shadow);border-left:6px solid var(--c1)}
.day.c1{border-left-color:var(--c1)}.day.c2{border-left-color:var(--c2)}.day.c3{border-left-color:var(--c3)}.day.c0{border-left-color:var(--muted)}
.day-head{display:flex;gap:18px;align-items:center;padding:20px 24px 6px}
.day-badge{flex:0 0 auto;width:58px;height:58px;border-radius:14px;display:grid;place-items:center;font-family:"Fraunces",serif;font-weight:600;font-size:1.15rem;color:#fff;line-height:1;text-align:center}
.day.c1 .day-badge{background:var(--c1)}.day.c2 .day-badge{background:var(--c2)}.day.c3 .day-badge{background:var(--c3)}.day.c0 .day-badge{background:var(--muted)}
.day-title h3{margin:2px 0 4px;font-size:1.4rem;font-weight:600;line-height:1.05}
.day-title .feel{margin:0;color:var(--c2);font-size:.82rem;font-weight:700}
.logistics{padding:4px 24px 12px}
.facts{display:grid;margin:6px 0 12px;border:1px solid var(--line);border-radius:12px;overflow:hidden}
.facts div{display:grid;grid-template-columns:64px 1fr;gap:12px;padding:9px 13px;border-bottom:1px solid var(--line);font-size:.86rem}
.facts div:last-child{border-bottom:0}
.facts span{color:var(--muted);font-size:.68rem;font-weight:800;letter-spacing:.08em;text-transform:uppercase;padding-top:2px}
.facts strong{font-weight:600}
.note{margin:0;color:var(--ink);font-size:.94rem;line-height:1.55}
/* SPOTS */
.spots-wrap{display:grid;gap:20px;padding:6px 24px 24px}
.travel-note{padding:40px;text-align:center;color:var(--muted);border:1px dashed var(--line);border-radius:14px;font-weight:600}
.spot{border:1px solid var(--line);border-radius:16px;overflow:hidden;background:var(--paper)}
.spot-head{display:flex;flex-wrap:wrap;justify-content:space-between;align-items:center;gap:10px;padding:14px 16px}
.spot-name{margin:0;font-size:1.22rem;font-weight:600}
.explore{display:flex;gap:6px;flex:0 0 auto}
.explore a{font-size:.7rem;font-weight:800;letter-spacing:.02em;text-decoration:none;padding:5px 10px;border-radius:999px;color:#fff;transition:.15s;white-space:nowrap}
.explore a:hover{filter:brightness(1.08);transform:translateY(-1px)}
.explore .xg{background:#4285F4}
.explore .xi{background:linear-gradient(45deg,#f09433,#dc2743 55%,#bc1888)}
.explore .xf{background:#0063dc}
/* CAROUSEL */
.carousel{position:relative;overflow:hidden;background:#e7e1d4}
.track{display:flex;overflow-x:auto;scroll-snap-type:x mandatory;scroll-behavior:smooth;scrollbar-width:none}
.track::-webkit-scrollbar{display:none}
.track figure{margin:0;flex:0 0 100%;scroll-snap-align:center;position:relative}
.track img{display:block;width:100%;aspect-ratio:3/2;object-fit:cover;background:#e7e1d4}
.track figcaption{position:absolute;left:0;right:0;bottom:0;padding:26px 14px 10px;color:#fff;font-size:.74rem;line-height:1.3;background:linear-gradient(180deg,transparent,rgba(0,0,0,.68))}
.track figcaption strong{display:block;font-weight:700}
.track figcaption span{color:rgba(255,255,255,.82);font-size:.66rem}
.nav{position:absolute;top:50%;transform:translateY(-50%);width:40px;height:40px;border-radius:50%;border:0;background:rgba(255,255,255,.86);color:var(--ink);font-size:1.4rem;line-height:1;cursor:pointer;display:grid;place-items:center;box-shadow:0 4px 14px rgba(0,0,0,.25);transition:.15s;z-index:2}
.nav:hover{background:#fff;transform:translateY(-50%) scale(1.08)}
.nav.prev{left:12px}.nav.next{right:12px}
.counter{position:absolute;top:12px;right:12px;background:rgba(0,0,0,.55);color:#fff;font-size:.72rem;font-weight:700;padding:4px 10px;border-radius:999px;z-index:2}
.dots{position:absolute;bottom:10px;left:0;right:0;display:flex;justify-content:center;gap:6px;z-index:2;flex-wrap:wrap;padding:0 40px}
.dots .dot{width:7px;height:7px;border-radius:50%;border:0;background:rgba(255,255,255,.5);cursor:pointer;padding:0;transition:.15s}
.dots .dot.on{background:#fff;width:20px;border-radius:999px}
/* SPOT GRID */
.spot-grid{display:grid;grid-template-columns:minmax(0,1.15fr) minmax(0,.85fr);gap:18px;padding:16px}
.mini-h{margin:0 0 6px;font-weight:800;font-size:.76rem;letter-spacing:.04em;text-transform:uppercase;color:var(--muted)}
.kv{margin-bottom:12px}
.kv span{font-weight:800;font-size:.78rem;color:var(--ink)}
.kv p{margin:4px 0 0;font-size:.9rem;color:var(--muted)}
.callout{border-radius:10px;padding:10px 12px;font-size:.86rem;margin-bottom:10px;line-height:1.45}
.callout b{font-weight:800}
.callout.save{background:rgba(63,125,78,.1);border-left:3px solid var(--save)}
.callout.save b{color:var(--save)}
.callout.splurge{background:rgba(217,164,65,.14);border-left:3px solid var(--splurge)}
.callout.splurge b{color:var(--splurge)}
.resto{margin:14px 0 4px}
.resto ul{margin:0;padding:0;list-style:none;display:grid;gap:8px}
.resto li{font-size:.85rem;color:var(--muted);line-height:1.4;padding-left:14px;position:relative}
.resto li::before{content:"";position:absolute;left:0;top:7px;width:6px;height:6px;border-radius:50%;background:var(--gold)}
.resto li a{text-decoration:none}.resto li b{color:var(--ink)}
.altbox{margin:14px 0 4px;padding:12px;background:rgba(31,111,120,.07);border-radius:10px}
.altbox p:last-child{margin:0;font-size:.86rem;color:var(--muted);line-height:1.45}
.altbox a{text-decoration:none}
.bloglinks{margin-top:14px;display:flex;flex-direction:column;gap:6px}
.bloglinks a{font-size:.83rem;text-decoration:none;color:var(--c1);font-weight:600}
.bloglinks a:hover{text-decoration:underline}
.spot-map{display:flex;flex-direction:column}
.mapwrap{position:relative;border-radius:12px;overflow:hidden;border:1px solid var(--line);flex:1;min-height:240px}
.gmap{width:100%;height:100%;min-height:240px;border:0;display:block}
.gmap-btn{margin-top:10px;text-align:center;background:var(--ink);color:#fff;text-decoration:none;font-weight:700;font-size:.85rem;padding:10px;border-radius:10px;transition:.15s}
.gmap-btn:hover{background:var(--c1)}
/* BUDGET */
.budget-tbl{width:100%;border-collapse:collapse;background:var(--card);border:1px solid var(--line);border-radius:16px;overflow:hidden;box-shadow:var(--shadow);font-size:.9rem}
.budget-tbl th,.budget-tbl td{padding:11px 14px;text-align:left;border-bottom:1px solid var(--line)}
.budget-tbl th{background:rgba(31,111,120,.08);font-family:"Fraunces",serif;font-weight:600}
.budget-tbl td:last-child,.budget-tbl th:last-child{text-align:right;font-variant-numeric:tabular-nums;white-space:nowrap}
.budget-tbl tr:last-child td{border-bottom:0;font-weight:700}
.budget-scroll{overflow-x:auto}
.matrix-tbl{table-layout:fixed}
.matrix-tbl th,.matrix-tbl td{white-space:normal;vertical-align:top;word-break:normal;overflow-wrap:anywhere}
.matrix-tbl td:last-child,.matrix-tbl th:last-child{text-align:left;white-space:normal;font-variant-numeric:normal}
.hc-list{list-style:none;padding:0;margin:0;background:var(--card);border:1px solid var(--line);border-radius:16px;overflow:hidden;box-shadow:var(--shadow)}
.hc-list li{padding:13px 18px;border-bottom:1px solid var(--line);border-left:4px solid var(--muted);line-height:1.5;font-size:.92rem}
.hc-list li:last-child{border-bottom:0}
.hc-list li.act{border-left-color:#c0392b}
.hc-list li.head{border-left-color:var(--gold)}
.hc-list li.solid{border-left-color:var(--c3)}
.hc-list li.fixed{border-left-color:var(--c1)}
.hc-list strong{font-family:"Fraunces",serif;font-weight:600}
.length-table{table-layout:fixed}
.length-table th:first-child,.length-table td:first-child{width:18%}
.length-table th:nth-child(2),.length-table td:nth-child(2){width:24%}
.length-table th:last-child,.length-table td:last-child{width:58%;text-align:left;font-variant-numeric:normal;white-space:normal}
.length-table td{vertical-align:middle;overflow-wrap:break-word}
@media (max-width:700px){
  .length-table,.length-table tbody,.length-table tr,.length-table th,.length-table td{display:block;width:100%}
  .length-table th:first-child,.length-table td:first-child,
  .length-table th:nth-child(2),.length-table td:nth-child(2),
  .length-table th:last-child,.length-table td:last-child{width:100%}
  .length-table tr:first-child{display:none}
  .length-table tr{padding:14px 16px;border-bottom:1px solid var(--line)}
  .length-table td{padding:0;border-bottom:0}
  .length-table td+td{margin-top:7px}
  .length-table td:nth-child(2){font-weight:700;color:var(--ink)}
}
.twocol{display:grid;grid-template-columns:1fr 1fr;gap:20px;margin-top:22px}
.listcard{background:var(--card);border:1px solid var(--line);border-radius:16px;padding:20px 22px;box-shadow:var(--shadow)}
.listcard h4{margin:0 0 12px;font-size:1.2rem;font-weight:600}
.listcard.save-list{border-top:4px solid var(--save)}
.listcard.splurge-list{border-top:4px solid var(--splurge)}
.listcard ul{margin:0;padding:0;list-style:none;display:grid;gap:10px}
.listcard li{font-size:.88rem;color:var(--muted);line-height:1.45;padding-left:22px;position:relative}
.save-list li::before{content:"💰";position:absolute;left:0;top:0}
.splurge-list li::before{content:"✨";position:absolute;left:0;top:0}
.listcard li b{color:var(--ink)}
/* BALANCE */
.bar{height:10px;border-radius:999px;background:rgba(26,23,18,.08);overflow:hidden;margin:14px 0 24px;display:flex}
.bar i{height:100%;display:block}
.balance{display:grid;grid-template-columns:repeat(auto-fit,minmax(220px,1fr));gap:18px}
.bcard{background:var(--card);border:1px solid var(--line);border-radius:16px;padding:22px;box-shadow:var(--shadow)}
.bcard .pct{font-family:"Fraunces",serif;font-size:2.4rem;font-weight:600;line-height:1}
.bcard.k1 .pct{color:var(--c1)}.bcard.k2 .pct{color:var(--c2)}.bcard.k3 .pct{color:var(--c3)}.bcard.k4 .pct{color:var(--muted)}
.bcard h4{margin:6px 0;font-family:"Inter",sans-serif;font-size:.95rem;font-weight:800}
.bcard p{margin:0;color:var(--muted);font-size:.84rem}
/* STATUS */
.status{display:grid;grid-template-columns:1fr 1fr;gap:20px}
.scol{background:var(--card);border:1px solid var(--line);border-radius:16px;padding:22px 24px;box-shadow:var(--shadow)}
.scol h4{margin:0 0 14px;font-size:1.3rem;font-weight:600;display:flex;align-items:center;gap:8px}
.scol.settled h4::before{content:"✓";color:var(--c3);font-weight:800}
.scol.open h4::before{content:"○";color:var(--c2);font-weight:800}
.scol .row{padding:10px 0;border-bottom:1px solid var(--line);font-size:.9rem}
.scol .row:last-child{border-bottom:0}
.scol .row b{display:block;margin-bottom:2px}
.scol .row span{color:var(--muted)}
footer{max-width:1360px;margin:0 auto;padding:20px clamp(18px,5vw,60px) 60px;color:var(--muted);font-size:.8rem;text-align:center;border-top:1px solid var(--line)}
footer a{color:var(--muted)}
@media(max-width:860px){
 header{min-height:80vh}
 h1{font-size:clamp(2.15rem,9.4vw,2.65rem);line-height:.94;overflow-wrap:anywhere}
 header .lead{max-width:100%;font-size:1rem}
 .plan-grid,.status,.twocol{grid-template-columns:1fr}
 .spot-grid{grid-template-columns:1fr}
 .day-head{gap:14px;padding:18px 16px 4px}
 .logistics{padding:4px 16px 10px}
 .spots-wrap{padding:6px 12px 18px}
 #tripmap{height:380px}
}

/* ===== TRIP SHORTLIST (redesigned cards) ===== */
#trips.shortlist{font-family:'Source Sans 3',system-ui,sans-serif;background:#efe8da;border-radius:22px;padding:40px clamp(20px,3vw,44px) 46px;border-top:0;margin-top:56px}
.sl-head{margin:0 0 26px;max-width:820px}
.sl-head .sl-eyebrow{margin:0 0 8px;color:#c04a2f;font-size:.72rem;font-weight:700;letter-spacing:.14em;text-transform:uppercase}
.sl-head h2{font-family:'Spectral',Georgia,serif;font-weight:700;color:#1c2620;font-size:clamp(1.8rem,4vw,2.7rem);line-height:1.05;margin:0 0 12px;letter-spacing:-.01em}
.sl-head p{margin:0;color:#5b625a;font-size:1rem;line-height:1.5}
.sl-grid{display:grid;grid-template-columns:repeat(auto-fit,minmax(300px,1fr));gap:22px}
.sl-card{background:#fff;border-radius:14px;overflow:hidden;box-shadow:0 1px 2px rgba(40,50,40,.05),0 6px 16px rgba(40,50,40,.06);display:flex;flex-direction:column;text-decoration:none;color:inherit;transition:transform .15s ease,box-shadow .15s ease}
.sl-card:hover{transform:translateY(-3px);box-shadow:0 4px 10px rgba(40,50,40,.09),0 16px 34px rgba(40,50,40,.14)}
.sl-card.top{border:1.5px solid #c04a2f}
.sl-photo{position:relative;height:170px;background:#d8d2c4}
.sl-photo img{width:100%;height:100%;object-fit:cover;display:block}
.madeira-stairway-card .sl-photo img{object-position:center 60%}
.sl-rank{position:absolute;top:9px;left:9px;width:28px;height:28px;border-radius:999px;background:#1a4a3c;color:#fff;font-weight:700;font-size:12px;display:flex;align-items:center;justify-content:center;box-shadow:0 1px 4px rgba(0,0,0,.3);z-index:2}
.sl-card.top .sl-rank{background:#c04a2f}
.sl-body{padding:13px 15px 15px;display:flex;flex-direction:column;gap:7px;flex:1}
.sl-meta{display:flex;align-items:baseline;justify-content:space-between;gap:8px}
.sl-dates{font-weight:700;font-size:11px;letter-spacing:.06em;color:#2f6b52;text-transform:uppercase}
.sl-pto{font-weight:700;font-size:11px;letter-spacing:.06em;color:#8a8f85;text-transform:uppercase;white-space:nowrap;text-align:right}
.sl-score{display:inline-flex;align-items:center;gap:4px;min-width:68px;padding:4px 9px 4px 10px;border:1px solid rgba(255,255,255,.28);border-radius:999px;background:#1a4a3c;color:#fff;box-shadow:0 2px 7px rgba(26,74,60,.24);font-variant-numeric:tabular-nums;line-height:1}
.sl-score b{font-family:'Spectral',Georgia,serif;font-size:21px;font-weight:700;letter-spacing:-.04em}
.sl-score>span{display:flex;flex-direction:column;gap:1px;color:rgba(255,255,255,.9);font-size:9px;font-weight:700}
.sl-score small{color:rgba(255,255,255,.68);font-size:7px;font-weight:700;letter-spacing:.08em;text-transform:uppercase}
.sl-card.top .sl-score{background:#c04a2f;box-shadow:0 2px 7px rgba(192,74,47,.26)}
.sl-excluded-head+.sl-grid .sl-score{background:#625f57;box-shadow:0 2px 7px rgba(54,52,47,.2)}
.sl-titlerow{display:flex;align-items:baseline;gap:9px}
.sl-titlerow h3{font-family:'Spectral',Georgia,serif;font-weight:700;font-size:20px;line-height:1.15;margin:0;color:#1c2620;flex:1}
.sl-nights{display:inline-flex;align-items:center;gap:4px;background:#eef3ee;border:1px solid #dbe6dd;border-radius:999px;padding:3px 9px;white-space:nowrap}
.sl-nights b{display:inline-flex;align-items:center;font-family:'Spectral',Georgia,serif;font-weight:700;font-size:14px;color:#1a4a3c;line-height:1}
.sl-nights i{display:inline-flex;align-items:center;font-style:normal;font-size:9.5px;font-weight:600;letter-spacing:.04em;color:#5b7a6b;line-height:1;text-transform:uppercase}
.sl-nights .sl-away{display:inline-flex;align-items:center;font-style:normal;font-size:8.5px;font-weight:700;letter-spacing:.02em;color:#9c6b43;background:#f6eee3;border:1px solid #e8d6c0;border-radius:999px;padding:2px 5px;margin-left:1px;text-transform:uppercase;line-height:1}
.sl-desc{margin:0;font-size:12.5px;line-height:1.5;color:#5b625a}
.sl-div{height:1px;background:#ece5d7;margin:1px 0}
.sl-logi{display:grid;grid-template-columns:minmax(0,1.7fr) minmax(0,1fr);gap:5px 12px;font-size:11px;line-height:1.35;color:#4a5149}
.sl-logi .lbl{color:#a29a88;font-weight:600;text-transform:uppercase;letter-spacing:.04em;font-size:9px}
.sl-budget-pill{display:inline-flex;align-items:center;margin-top:3px;padding:4px 8px;border:1px solid transparent;border-radius:999px;font-weight:700;line-height:1;white-space:nowrap}
.sl-budget-pill.target-fit{background:#dff3e8;border-color:#b9dfc9;color:#236b4d}
.sl-budget-pill.within-preference{background:#fff0c9;border-color:#ead38d;color:#7a5715}
.sl-budget-pill.over-preference{background:#f6e2c9;border-color:#e6bd82;color:#965716}
.sl-tags{display:flex;flex-wrap:wrap;gap:5px;margin-top:1px}
.sl-tags span{font-size:10px;font-weight:600;color:#2f6b52;background:#e6efe8;border-radius:5px;padding:2px 7px}
.sl-tags .warn{color:#b0601c;background:#f6e6d3}
.sl-tags .bad{color:#b1372a;background:#f6ddd8}
.sl-readiness{display:grid;gap:2px;margin-top:2px;padding-top:7px;border-top:1px solid #ece5d7;color:#4a5149;font-size:11px;line-height:1.35}
.sl-readiness .lbl{color:#a29a88;font-size:9px;font-weight:600;letter-spacing:.04em;text-transform:uppercase}
.sl-excluded-head{margin:8px 0 22px;padding-top:26px;border-top:1px dashed #d8d0bd;max-width:820px}
.sl-excluded-head .sl-eyebrow{margin:0 0 8px;color:#8a8377;font-size:.72rem;font-weight:700;letter-spacing:.14em;text-transform:uppercase}
.sl-excluded-head h3{font-family:'Spectral',Georgia,serif;font-weight:700;color:#1c2620;font-size:clamp(1.3rem,3vw,1.7rem);line-height:1.15;margin:0 0 8px}
.sl-excluded-head p{margin:0;color:#5b625a;font-size:.92rem;line-height:1.5}
/* SEPARATE TRIP */
#seattle-rainier{border:0;border-radius:22px;padding:0;margin-top:56px;overflow:hidden;background:#1d2928;box-shadow:var(--shadow)}
.separate-trip-card{display:grid;grid-template-columns:minmax(280px,.9fr) minmax(0,1.1fr);min-height:300px;color:#fff;text-decoration:none}
.separate-trip-photo{position:relative;min-height:300px;overflow:hidden;background:#43534e}
.separate-trip-photo::after{content:"";position:absolute;inset:0;background:linear-gradient(180deg,rgba(9,18,18,.02),rgba(9,18,18,.42))}
.separate-trip-photo img{width:100%;height:100%;object-fit:cover;display:block;transition:transform .35s ease}
.separate-trip-badge{position:absolute;z-index:1;top:16px;left:16px;padding:6px 11px;border-radius:999px;background:#f1c878;color:#392c12;font-size:.68rem;font-weight:900;letter-spacing:.1em;text-transform:uppercase;box-shadow:0 3px 12px rgba(0,0,0,.25)}
.separate-trip-body{display:flex;flex-direction:column;justify-content:center;padding:34px clamp(24px,4vw,52px)}
.separate-trip-body .eyebrow{color:#f1c878}
.separate-trip-body h2{margin:0 0 12px;font-family:'Spectral',Georgia,serif;font-size:clamp(2rem,4vw,3.1rem);line-height:1.02;color:#fff}
.separate-trip-body>p:not(.eyebrow){margin:0 0 20px;max-width:620px;color:rgba(255,255,255,.78);font-size:.95rem;line-height:1.55}
.separate-trip-tags{display:flex;flex-wrap:wrap;gap:8px;margin-bottom:22px}
.separate-trip-tags span{padding:6px 10px;border:1px solid rgba(255,255,255,.2);border-radius:999px;background:rgba(255,255,255,.08);color:rgba(255,255,255,.9);font-size:.7rem;font-weight:800}
.separate-trip-cta{align-self:flex-start;color:#1d2928;background:#f1c878;border-radius:999px;padding:9px 15px;font-size:.78rem;font-weight:900}
.separate-trip-card:hover .separate-trip-photo img{transform:scale(1.025)}
.separate-trip-card:hover .separate-trip-cta{text-decoration:underline;text-underline-offset:3px}
@media(max-width:760px){.separate-trip-card{grid-template-columns:1fr}.separate-trip-photo{min-height:230px}.separate-trip-body{padding:26px 22px 30px}}
/* SHORT, EASY ESCAPES */
#short-trips{font-family:'Source Sans 3',system-ui,sans-serif;background:linear-gradient(145deg,#173f42,#235e5c);border:0;border-radius:22px;padding:40px clamp(20px,3vw,44px) 44px;margin-top:56px;color:#fff;overflow:hidden}
#short-trips .short-head{max-width:780px;margin-bottom:26px}
#short-trips .eyebrow{color:#f1c878}
#short-trips h2{margin:0 0 10px;font-family:'Spectral',Georgia,serif;font-size:clamp(1.9rem,4vw,2.8rem);line-height:1.05;color:#fff}
#short-trips .short-head>p:last-child{margin:0;color:rgba(255,255,255,.78)}
.short-method{margin-top:10px!important;font-size:.78rem;line-height:1.45}
.short-grid{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:18px}
.short-card{min-width:0;overflow:hidden;border:1px solid rgba(255,255,255,.2);border-radius:16px;background:#fffdf8;color:#1c2620;text-decoration:none;box-shadow:0 16px 38px rgba(3,19,20,.25);transition:transform .18s ease,box-shadow .18s ease}
.short-card:first-child{border-color:#f1c878;box-shadow:0 18px 44px rgba(3,19,20,.34),0 0 0 2px #f1c878}
.short-card:hover{transform:translateY(-4px);box-shadow:0 22px 48px rgba(3,19,20,.34)}
.short-photo{position:relative;height:190px;background:#d8d2c4}
.short-photo img{width:100%;height:100%;object-fit:cover;display:block}
.short-badge{position:absolute;left:12px;top:12px;padding:5px 10px;border-radius:999px;background:#f1c878;color:#392c12;font-size:.68rem;font-weight:900;letter-spacing:.08em;text-transform:uppercase;box-shadow:0 3px 10px rgba(0,0,0,.22)}
.short-score{position:absolute;right:12px;top:12px;padding:5px 10px;border-radius:999px;background:rgba(23,63,66,.94);color:#fff;font-size:.68rem;font-weight:900;letter-spacing:.04em;box-shadow:0 3px 10px rgba(0,0,0,.22)}
.short-body{padding:17px 18px 19px}
.short-dates{display:block;margin-bottom:5px;color:#2f6b52;font-size:.69rem;font-weight:800;letter-spacing:.08em;text-transform:uppercase}
.short-body h3{margin:0 0 7px;font-family:'Spectral',Georgia,serif;font-size:1.45rem;line-height:1.05}
.short-body>p{min-height:3.2em;margin:0 0 14px;color:#5b625a;font-size:.85rem;line-height:1.5}
.short-verdict{min-height:3em!important;margin-top:-5px!important;color:#315f50!important;font-size:.76rem!important;font-weight:700}
.short-stats{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:8px;padding-top:13px;border-top:1px solid #e8e0d2}
.short-stat{padding:8px 9px;border-radius:9px;background:#eef3ee}
.short-stat span{display:block;color:#778176;font-size:.61rem;font-weight:800;letter-spacing:.07em;text-transform:uppercase}
.short-stat b{display:block;margin-top:1px;color:#1a4a3c;font-size:.83rem;line-height:1.25}
.short-ready{margin-top:11px;color:#2f6b52;font-size:.72rem;font-weight:800}
@media(max-width:1000px){.short-grid{grid-template-columns:repeat(2,minmax(0,1fr))}}
@media(max-width:700px){.short-grid{grid-template-columns:1fr}.short-photo{height:clamp(180px,42vw,260px)}.short-body>p{min-height:0}}

/* TRIP LENGTH REALITY CHECK */
#trip-length .lm-legend{display:flex;flex-wrap:wrap;gap:18px;margin:0 0 20px;font-size:.78rem;font-weight:700;color:#4a453d}
#trip-length .lm-legend span{display:inline-flex;align-items:center;gap:7px}
#trip-length .lm-legend i{width:14px;height:14px;border-radius:4px;background:#00939e}
#trip-length .lm-legend i.lm-short{background:#c25a3a}
.lm-grid{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:18px}
.lm-card{display:flex;flex-direction:column;background:var(--card);border:1px solid var(--line);border-radius:16px;padding:20px 20px 18px;box-shadow:0 10px 26px rgba(30,32,28,.08)}
.lm-card h3{margin:0 0 4px;font-size:1.12rem}
.lm-card .lm-sub{margin:0 0 18px;color:var(--muted);font-size:.79rem;line-height:1.45}
.lm-row{margin-bottom:13px}
.lm-row-top{display:flex;justify-content:space-between;align-items:baseline;gap:10px;margin-bottom:4px}
.lm-row-top span{font-size:.77rem;font-weight:700;color:#4a453d}
.lm-row-top b{font-size:.95rem;font-variant-numeric:tabular-nums;white-space:nowrap}
.lm-bar{height:14px;min-width:3px;border-radius:0 4px 4px 0;background:#00939e}
