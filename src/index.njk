.compare-table thead th.sort-desc::after{content:" \25BC";font-size:.7em;opacity:.85}
.na{color:#8b8375;font-weight:850}
.winner-grid{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:14px}
.winner-card{background:#fff;border:1px solid var(--line);border-radius:18px;padding:16px;box-shadow:0 8px 24px rgba(36,54,57,.07)}
.winner-card h3{margin:0 0 6px;color:#193c45}
.winner-card b{color:#2f8f65}
.winner-card p{margin:0;color:#4f5d5e;line-height:1.5}
.matrix-wrap{overflow:auto;border:1px solid var(--line);border-radius:22px;box-shadow:var(--shadow);background:#fff}
.compare-table{width:100%;border-collapse:collapse}
.compare-table th,.compare-table td{padding:10px 8px;border-bottom:1px solid var(--line);text-align:left;vertical-align:middle}
.compare-table thead th{background:#f5efe3;color:#193c45;font-size:.8rem;text-transform:uppercase;letter-spacing:.08em}
.compare-table tbody th span{display:block;color:#193c45}
.compare-table tbody th small{display:block;color:var(--muted);font-weight:800;margin-top:4px}
.compare-table tr.is-picked th,.compare-table tr.is-picked td{background:#eef9f2}
.compare-table tr.is-picked th{box-shadow:inset 6px 0 0 #2f8f65}
.compare-table tr.is-picked td:last-child{background:#e7f6ed;color:#14573a}
.risk-grid{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:14px}
.file-list{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:12px}
.file-list a,.file-list span{display:flex;justify-content:space-between;gap:12px;align-items:center;border:1px solid var(--line);background:#fff;border-radius:14px;padding:12px 14px;color:#255b5d;text-decoration:none;font-weight:900}
.file-list small{color:var(--muted);font-weight:800}
.source-note{font-size:.85rem;color:var(--muted);line-height:1.5}
.rubric-note{background:#fff;border:1px solid var(--line);border-radius:16px;padding:16px 18px;font-size:.86rem;color:#4f5d5e;line-height:1.6;margin-bottom:18px}
.rubric-note b{color:#193c45}
@media (max-width:980px){.trip-grid,.risk-grid{grid-template-columns:1fr 1fr}.decision-console,.winner-grid,.file-list{grid-template-columns:1fr}}
@media (max-width:640px){.trip-grid,.risk-grid{grid-template-columns:1fr}.trip-photo{height:132px}.hero-kicker{max-width:100%}.hero-kicker span{flex:1 1 100%;min-width:0;max-width:100%;white-space:normal;overflow-wrap:anywhere;font-size:.76rem;line-height:1.25}.winner-callout h3{font-size:1.45rem}}
</style>
