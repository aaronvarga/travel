<script>
function setPriority(key){
  document.querySelectorAll('.decision-row').forEach(r => r.classList.toggle('on', r.dataset.priority === key));
  const trip = document.querySelector('.decision-row[data-priority="' + key + '"]')?.dataset.trip;
  document.querySelectorAll('[data-trip]').forEach(el => el.classList.toggle('is-picked', el.dataset.trip === trip));
}
document.querySelectorAll('.decision-row').forEach(r => r.addEventListener('click', () => setPriority(r.dataset.priority)));
document.querySelectorAll('.compare-table td .rating').forEach(r => {
  const n = +((r.getAttribute('aria-label') || '').match(/\d+/)?.[0] || 0);
  const tier = n >= 5 ? 'good' : n >= 3 ? 'mixed' : 'weak';
  const b = r.nextElementSibling;
  const td = r.closest('td');
  if (td) td.classList.add('score-' + tier);
  const chip = document.createElement('span');
  chip.className = 'score-chip ' + tier;
  chip.textContent = n || '–';
  chip.setAttribute('aria-label', n + ' out of 5');
  r.replaceWith(chip);
  if (b && b.tagName === 'B') b.remove();
});
document.querySelectorAll('.trip-photo img').forEach(img => {
  if (img.complete && img.naturalWidth === 0) img.closest('.trip-photo')?.classList.add('img-failed');
  img.addEventListener('error', () => img.closest('.trip-photo')?.classList.add('img-failed'), { once: true });
});
setPriority('balanced');
</script>
<script>/*site nav*/(function(){var nav=document.querySelector(".site-nav");if(!nav)return;var menu=nav.querySelector(".site-nav-menu"),summary=nav.querySelector("summary"),box=nav.querySelector(".site-nav-links"),mq=window.matchMedia("(min-width:960px)");function sync(){if(menu)menu.open=mq.matches;}sync();if(mq.addEventListener)mq.addEventListener("change",sync);else mq.addListener(sync);if(summary)summary.addEventListener("click",function(e){if(mq.matches)e.preventDefault();});var links=[].slice.call(nav.querySelectorAll('.site-nav-links a[href^="#"]'));links.forEach(function(a){a.addEventListener("click",function(){if(menu&&!mq.matches)menu.open=false;});});var map={},secs=[];links.forEach(function(a){var id=a.getAttribute("href").slice(1);var el=document.getElementById(id);if(el){map[id]=a;secs.push(el);}});if(!secs.length)return;var cur=null;function keepVisible(a){if(!box)return;var top=a.offsetTop-box.offsetTop;if(top<box.scrollTop+12)box.scrollTo({top:Math.max(0,top-12),behavior:"smooth"});else if(top+a.offsetHeight>box.scrollTop+box.clientHeight-12)box.scrollTo({top:top+a.offsetHeight-box.clientHeight+12,behavior:"smooth"});}function setActive(a){if(a===cur)return;cur=a;links.forEach(function(l){l.classList.toggle("active",l===a);});keepVisible(a);}var io=new IntersectionObserver(function(es){es.forEach(function(en){if(en.isIntersecting&&map[en.target.id])setActive(map[en.target.id]);});},{rootMargin:"-50% 0px -50% 0px",threshold:0});secs.forEach(function(s){io.observe(s);});})();</script>
<script>
/* The flight desk starts with the easiest handoffs, then sorts by whichever
   constraint the family is trying to minimize. Server order is the ascending
   complexity → fragility → time sequence. */
(function () {
  var table = document.getElementById('mid-trip-flight-table');
  if (!table) return;
  var body = table.tBodies[0];
  var buttons = Array.prototype.slice.call(table.querySelectorAll('[data-flight-sort]'));
  var active = 'complexity';
  var direction = 1;

  function sort(key) {
    direction = key === active ? -direction : -1;
    active = key;
    Array.prototype.slice.call(body.rows).sort(function (a, b) {
      var first = Number(a.dataset[key]);
      var second = Number(b.dataset[key]);
      return first === second
        ? a.cells[0].textContent.localeCompare(b.cells[0].textContent)
        : direction * (first - second);
    }).forEach(function (row) { body.appendChild(row); });
    buttons.forEach(function (button) {
      var selected = button.dataset.flightSort === active;
      button.setAttribute('aria-pressed', selected ? 'true' : 'false');
      button.querySelector('span').textContent = selected ? (direction < 0 ? '↓' : '↑') : '';
    });
  }

  buttons.forEach(function (button) {
    button.addEventListener('click', function () { sort(button.dataset.flightSort); });
  });
}());
</script>
