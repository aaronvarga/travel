---
pagination:
  data: composer.combos
  size: 1
  alias: combo
permalink: "/locations/{{ combo.slug }}/index.html"
---
{%- from "itinerary/macros.njk" import day -%}
{%- from "composer/sections.njk" import badge, empty, heading -%}
<!doctype html><html lang="en"><head><meta charset="utf-8"><meta name="viewport" content="width=device-width,initial-scale=1"><title>{{ combo.startName }} · {{ combo.partnerName }} — June 2027</title><link rel="stylesheet" href="https://unpkg.com/leaflet@1.9.4/dist/leaflet.css"><link rel="stylesheet" href="../../assets/css/composer-shell.css?v=20260712-parity-2"><link rel="stylesheet" href="../../assets/css/itinerary.css?v=20260710-travel-frame-all"></head><body data-trip-slug="{{ combo.slug }}">
<section class="preview composer-preview">
  <div class="pv-pane">
    <span class="pv-kicker">Family Trip · {{ combo.departDate | displayDate }}–{{ combo.returnDate | displayDate }} {{ badge('estimated','Estimated') }}</span>
    <h1>{{ combo.startName }} + {{ combo.partnerName }}<span>Composed family itinerary</span></h1>
    <p class="pv-lead">A complete draft assembled from reviewed {{ combo.startName }} and {{ combo.partnerName }} destination legs, with the transfer, calendar, budget, and score recalculated for this pairing.</p>
    <div class="pv-stats has-travel-frame"><div><b>{{ combo.totalNights }}</b><span>Nights away {{ badge('estimated','Estimated') }}</span></div><div><b>2{% if combo.edgeNights %}+1{% endif %}</b><span>Home bases</span></div><div><b>{{ combo.mapPoints | length }}</b><span>Stops mapped</span></div><div><b>{{ combo.scorecard.pto.days }}</b><span>PTO days {{ badge('estimated','Estimated') }}</span></div><div data-travel-frame><b data-preserve-date>{{ combo.departDate | displayDate }}–{{ combo.returnDate | displayDate }}</b><span>Travel frame</span></div></div>
    <div class="pv-split" role="img" aria-label="Trip mix is estimated from the two source legs"><div class="seg water" style="flex:34"><b>34%</b><span>Water</span></div><div class="seg town" style="flex:28"><b>28%</b><span>Towns &amp; food</span></div><div class="seg nature" style="flex:38"><b>38%</b><span>Nature</span></div></div>
    <p class="pv-cue">↓ Full day-by-day plan below</p>
  </div>
  <div class="carousel pvcar" data-n="{{ combo.heroImages | length }}"><div class="track">{% for image in combo.heroImages %}<figure><img src="{{ image.src | safe }}" alt="{{ image.alt | safe }}" loading="{% if loop.first %}eager{% else %}lazy{% endif %}"><figcaption><span class="cap-day">{{ combo.startName }} + {{ combo.partnerName }}</span><strong>{{ image.captionTitle | safe }}</strong><span class="cap-desc">Verified source photography</span></figcaption></figure>{% endfor %}</div><button class="nav prev" aria-label="Previous">‹</button><button class="nav next" aria-label="Next">›</button><div class="counter"><span class="cur">1</span> / {{ combo.heroImages | length }}</div><div class="dots">{% for image in combo.heroImages %}<button class="dot" data-i="{{ loop.index0 }}" aria-label="Photo {{ loop.index }}"></button>{% endfor %}</div></div>
</section>
<nav class="site-nav" aria-label="Page sections"><details class="site-nav-menu"><summary><span>Sections</span></summary><div class="site-nav-links"><a href="../../index.html" class="nav-home">← All Trips</a><a href="#overview">Overview</a><a href="#why-this-trip">Why This Trip</a><a href="#kids-favorites">Kids’ Favorites</a><a href="#stays">Where We Stay</a><a href="#calendar">Calendar</a><a href="#itinerary">Day by Day</a><a href="#map">Trip Map</a><a href="#air-travel">Air Travel</a><a href="#getting-around">Getting Around</a><a href="#entry">Entry &amp; Docs</a><a href="#health-check">Health-Check</a><a href="#timing">Best Time</a><a href="#todo">To-Do</a><a href="#budget">Budget</a><a href="#tips">Travel Tips</a><a href="#packing">Packing</a><a href="#social">What People Say</a><a href="#balance">Trip Balance</a><a href="#status">Settled &amp; Open</a><a href="#photo-guide">Photo Guide</a><a href="#food-guide">Food Guide</a><a href="#recommendation-readiness">Recommendation Readiness</a><a href="#recommendation-evidence">Evidence</a><a href="#variants">Variants</a></div></details></nav>
<main>
<section id="overview">{{ heading('The Plan at a Glance', combo.startName + ' + ' + combo.partnerName, 'The route, timing, cost, and appeal score below are recomputed for this composed pairing.', 'estimated', 'Estimated') }}<div class="composer-status"><b>Composed itinerary.</b> Destination-local content comes from reviewed source trips; combination-level dates, logistics, scores, and budgets remain estimated until audited. Sources: {% for ref in combo.sourceRefs %}<a href="../{{ ref }}/">{{ ref }}</a>{% if not loop.last %}, {% endif %}{% endfor %}.</div><div class="overview"><div class="ocard"><p class="eyebrow">Route</p><h4>{{ combo.startName }} → {{ combo.partnerName }}</h4><p>{{ combo.transfer.mode }} transfer{% if combo.transfer.via.length %} via {{ combo.transfer.via | join(' + ') }}{% endif %}; {{ combo.transfer.hours }} planning hours.</p></div><div class="ocard"><p class="eyebrow">Lodging split</p><h4>{{ combo.legNightsA }} + {{ combo.edgeNights }} + {{ combo.legNightsB }} nights</h4><p>{{ combo.startName }}, {% if combo.edgeNights %}buffer city, {% endif %}then {{ combo.partnerName }}.</p></div><div class="ocard"><p class="eyebrow">Rough all-in</p><h4>{{ combo.budget.floorUsd | money }}–{{ combo.budget.ceilUsd | money }} {{ badge('estimated','Estimated') }}</h4><p>Family-of-four deterministic planning range; live quotes are not yet audited.</p></div><div class="ocard"><p class="eyebrow">Appeal</p><h4>{{ combo.scorecard.totalBaked }}/55 {{ badge('estimated','Estimated') }}</h4><p>Budget remains double-weighted; fire safety is included once; PTO remains displayed at weight zero.</p></div></div></section>
  <section id="why-this-trip" class="divider">{{ heading('The Case for This Route','Why this trip works','The destination-local strengths are inherited from reviewed source legs; the combined verdict remains provisional.','unverified','Unverified') }}<div class="twocol"><div class="listcard pro-list"><h4>{{ combo.startName }}</h4><ul><li><span>Reviewed destination days, photography, map points, and local practical notes.</span></li><li><span>{{ combo.legNightsA }} nights provide the first half of the route.</span></li></ul></div><div class="listcard pro-list"><h4>{{ combo.partnerName }}</h4><ul><li><span>Reviewed destination days, photography, map points, and local practical notes.</span></li><li><span>{{ combo.legNightsB }} nights provide the second half of the route.</span></li></ul></div></div></section>
  <section id="kids-favorites" class="divider">{{ heading('Family Highlights','Kids’ likely favorites','Specific favorites have not been independently tested for this exact pairing.','unverified','Unverified') }}{{ empty('Not yet verified','The source legs contain family-oriented activities, but this composed route still needs a deliberate age-by-age favorites review.') }}</section>
  <section id="stays" class="divider">{{ heading('Where We Stay','Bases that keep the route practical','Base counts and night allocations are composer outputs; exact properties are not selected.','estimated','Estimated') }}<div class="bases"><article class="base b1"><div class="band"></div><div class="bbody"><span class="nights">{{ combo.legNightsA }} nights</span><h4>{{ combo.startName }}</h4><p>Use the reviewed source leg’s preferred base pattern; property selection remains open.</p></div></article>{% if combo.edgeNights %}<article class="base b2"><div class="band"></div><div class="bbody"><span class="nights">{{ combo.edgeNights }} night</span><h4>Transfer buffer</h4><p>Required resilience night attached to the transfer edge.</p></div></article>{% endif %}<article class="base b3"><div class="band"></div><div class="bbody"><span class="nights">{{ combo.legNightsB }} nights</span><h4>{{ combo.partnerName }}</h4><p>Use the reviewed source leg’s preferred base pattern; property selection remains open.</p></div></article></div></section>
  <section id="calendar" class="divider">{{ heading('Calendar','The trip at a glance','Dates are generated from the canonical night and blackout model.','estimated','Estimated') }}<div class="overview"><div class="ocard"><p class="eyebrow">Depart</p><h4>{{ combo.departDate }}</h4><p>Evening departure model.</p></div><div class="ocard"><p class="eyebrow">Return</p><h4>{{ combo.returnDate }}</h4><p>Before the June 24–26 Pittsburgh blackout.</p></div><div class="ocard"><p class="eyebrow">Calendar</p><h4>{{ combo.calendarDays }} days</h4><p>{{ combo.totalNights }} hotel nights.</p></div><div class="ocard"><p class="eyebrow">PTO</p><h4>{{ combo.scorecard.pto.days }} days</h4><p>Weekdays excluding observed Juneteenth.</p></div></div></section>
  <section id="itinerary" class="divider"><div class="section-label"><p class="eyebrow">Day by Day</p><h2>{{ combo.startName }} + {{ combo.partnerName }} {{ badge('unverified','Mixed verification') }}</h2><p>Destination days are verified-source content. Transfer boundaries, dates, costs, and the combined ordering remain estimated.</p></div><div class="days">{% for d in combo.itinerary.days %}{{ day(d) }}{% endfor %}</div></section>
  {% include "itinerary/composed-map.njk" %}
  <section id="air-travel" class="divider">{{ heading('Air Travel','The flight chain','The transfer shape is useful planning information; exact 2027 inventory is not confirmed.','unverified','Unverified') }}<div class="overview"><div class="ocard"><p class="eyebrow">Outbound</p><h4>PIT → {{ combo.startName }}</h4><p>Protected gateway itinerary required.</p></div><div class="ocard"><p class="eyebrow">Mid-trip</p><h4>{{ combo.transfer.mode }} · {{ combo.transfer.hours }} hours</h4><p>{{ combo.transfer.watch }}</p></div><div class="ocard"><p class="eyebrow">Return</p><h4>{{ combo.partnerName }} → PIT</h4><p>Protected gateway itinerary required.</p></div></div></section>
  <section id="getting-around" class="divider">{{ heading('Getting Around','Cars, ferries, and local movement','Local transport assumptions are inherited from leg budgets, but the exact handoffs need review.','estimated','Estimated') }}<div class="overview"><div class="ocard"><p class="eyebrow">First leg</p><h4>{{ combo.startName }}</h4><p>Local transport allowance included in the itemized budget.</p></div><div class="ocard"><p class="eyebrow">Handoff</p><h4>{{ combo.transfer.mode }}</h4><p>Confirm baggage, vehicle, and ticket protection rules.</p></div><div class="ocard"><p class="eyebrow">Second leg</p><h4>{{ combo.partnerName }}</h4><p>Local transport allowance included in the itemized budget.</p></div></div></section>
  <section id="entry" class="divider">{{ heading('Entry & Documents','Passports and essentials','Country-specific entry, driving, health, and connectivity rules have not been merged for this pairing.','unverified','Unverified') }}{{ empty('Not yet verified','Complete the combined-country passport, ETIAS, driving-permit, insurance, medical, money, and connectivity review before booking.') }}</section>
  <section id="health-check" class="divider">{{ heading('Plan Health-Check','What to lock, watch, and expect','The composer validates structure; a human booking-readiness audit is still outstanding.','unverified','Unverified') }}<div class="status-grid"><div class="status-col"><h3>Structurally checked</h3><div class="row"><b>Timeline</b><span>Every calendar date is covered once.</span></div><div class="row"><b>Budget math</b><span>Every line item reconciles to the displayed range.</span></div><div class="row"><b>Blackout</b><span>Return occurs by June 23.</span></div></div><div class="status-col"><h3>Still needs audit</h3><div class="row"><b>Schedules</b><span>Exact 2027 service and protected-ticket options.</span></div><div class="row"><b>Quotes</b><span>Live airfare, lodging, cars, ferries, and activities.</span></div><div class="row"><b>Evidence</b><span>Combination-level sources and confidence grading.</span></div></div></div></section>
  <section id="timing" class="divider">{{ heading('Best Time','Why these dates','The blackout constraint is verified; destination-level weather fit has not been re-audited for the exact sequence.','unverified','Unverified') }}{{ empty('Not yet verified','Compare the exact dates against heat, wind, sea temperature, closures, ferry calendars, and destination events for both legs.') }}</section>
  <section id="todo" class="divider">{{ heading('Before You Go','Pre-departure to-do list','The composed route does not yet have a booking calendar.','unverified','Unverified') }}{{ empty('Not yet verified','Build a dated booking order after the flights, transfer edge, lodging bases, and cancellation strategy are audited.') }}</section>
  <section id="budget" class="divider">{{ heading('The Money','Budget, savers & splurges','All rows are deterministic rollups from leg ranges and the selected transfer edge.','estimated','Estimated') }}<div class="budget-scroll"><table class="budget-tbl"><tbody><tr><th>Line item</th><th>Estimate (family of 4)</th></tr>{% for row in combo.budgetRows %}<tr id="{{ row.id }}"><td>{{ row.label }}</td><td>{{ row.floorUsd | money }}–{{ row.ceilUsd | money }}</td></tr>{% endfor %}</tbody></table></div></section>
  <section id="totals" class="divider">{{ heading('Bottom Line','Total trip cost','This planning range is not a live quote.','estimated','Estimated') }}<div class="budget-scroll"><table class="budget-tbl grand"><tbody><tr><th>Category</th><th>Estimate (family of 4)</th></tr><tr><td>All itemized composer rows</td><td>{{ combo.budget.floorUsd | money }}–{{ combo.budget.ceilUsd | money }}</td></tr><tr class="total"><td>Grand total — family of 4</td><td>{{ combo.budget.floorUsd | money }}–{{ combo.budget.ceilUsd | money }}</td></tr></tbody></table></div><p class="rate-note">Re-quote every component before booking. A low Budget score is a warning, never an exclusion.</p></section>
  <section id="tips" class="divider">{{ heading('Travel Tips','The stuff nobody tells you','Local tips exist in the source legs, but they have not been reconciled into one combination-level booking guide.','unverified','Unverified') }}{{ empty('Not yet verified','Merge the strongest operational notes from both source trips, remove conflicts, and add transfer-specific failure plans.') }}</section>
  <section id="packing" class="divider">{{ heading('Packing','What to bring','Packing tags are inherited from both source legs; the final consolidated list is not audited.','unverified','Unverified') }}{{ empty('Not yet verified','Combine the family baseline with weather, hiking, water, driving, and destination-specific gear requirements for this exact route.') }}</section>
  <section id="social" class="divider">{{ heading('What People Are Saying','Insider field notes','No combination-level crowd-source review has been completed.','unverified','Unverified') }}{{ empty('Not yet verified','Review current traveler reports for both legs and the exact transfer, then preserve only actionable, date-relevant advice.') }}</section>
  <section id="balance" class="divider">{{ heading('Trip Balance','What the days add up to','The split is inferred from leg variety tags rather than audited day categorization.','estimated','Estimated') }}<div class="bar"><i style="width:34%;background:#1f6f78"></i><i style="width:28%;background:#c25a3a"></i><i style="width:38%;background:#3f7d4e"></i></div><div class="balance"><div class="bcard k1"><div class="pct">34%</div><h4>Water / swim / boats</h4></div><div class="bcard k2"><div class="pct">28%</div><h4>Towns / food / texture</h4></div><div class="bcard k3"><div class="pct">38%</div><h4>Nature / hikes</h4></div></div></section>
  <section id="status" class="divider">{{ heading('Decisions','Settled & still open','Structural choices are settled; booking choices are not.','unverified','Unverified') }}<div class="status"><div class="scol settled"><h4>Settled</h4><div class="row"><b>Route</b><span>{{ combo.startName }} → {{ combo.partnerName }}</span></div><div class="row"><b>Dates</b><span>{{ combo.departDate }}–{{ combo.returnDate }}</span></div><div class="row"><b>Nights</b><span>{{ combo.totalNights }} total</span></div></div><div class="scol open"><h4>Still Open</h4><div class="row"><b>Flights</b><span>Exact 2027 itinerary and fare.</span></div><div class="row"><b>Lodging</b><span>Properties and cancellation terms.</span></div><div class="row"><b>Final audit</b><span>Evidence, family fit, and booking readiness.</span></div></div></div></section>
  <section id="photo-guide" class="divider">{{ heading('Photo Guide','Where and when to photograph','Source imagery is present, but the combined route has no date-specific light plan.','unverified','Unverified') }}{{ empty('Not yet verified','Build sunrise, sunset, blue-hour, access, lens, and weather-backup guidance for every scheduled flagship location.') }}</section>
  <section id="food-guide" class="divider">{{ heading('Food Guide','Family food plan','Restaurant notes exist inside source spots, but the route-wide dining plan is incomplete.','unverified','Unverified') }}{{ empty('Not yet verified','Reconcile current restaurants, grocery access, picky-eater fallbacks, reservation needs, and remote-day food logistics.') }}</section>
  <section id="recommendation-readiness" class="divider evidence-section">{{ heading('Recommendation Readiness','Appeal, readiness, and confidence','The /55 score describes estimated family appeal; it does not certify a future schedule or live quote.','estimated','Estimated') }}<div class="evidence-summary-grid"><article><span>Appeal score</span><strong>{{ combo.scorecard.totalBaked }}/55</strong><p>Deterministically derived from composer hints and rubrics.</p></article><article><span>Route readiness</span><strong>Draft</strong><p>Exact 2027 service remains unverified.</p></article><article><span>Evidence confidence</span><strong>Not audited</strong><p>Source legs are reviewed; this combination is not.</p></article><article><span>Budget preference</span><strong>{% if combo.budget.ceilUsd > 15000 %}Range crosses $15k{% else %}Range within $15k{% endif %}</strong><p>{{ combo.budget.floorUsd | money }}–{{ combo.budget.ceilUsd | money }} planning band.</p></article></div><ul class="score-axis-list">{% for id, value in combo.scorecard.axes %}<li><span class="axis-name">{{ id }}</span><span class="axis-value">{{ value }}/5 {{ badge('estimated','Estimated') }}</span></li>{% endfor %}</ul></section>
  <section id="recommendation-evidence" class="divider evidence-section">{{ heading('Recommendation Evidence','Why the scores are not audited yet','No combination-level evidence ledger has been created.','unverified','Unverified') }}{{ empty('Not yet verified','Attach current sources and confidence grades to every score axis, transfer claim, climate claim, and cost proxy.') }}</section>
  <section id="variants" class="divider evidence-section">{{ heading('Trip Variants','Shorter and alternate versions','Only the canonical composed pair is generated in v1.','unverified','Unverified') }}{{ empty('Not yet verified','Review shorter-night allocations, alternate gateways, and fallback transfer edges before publishing variants.') }}</section>
</main>
<dialog class="trip-gallery-dialog" id="tripGalleryDialog" data-trip-slug="{{ combo.slug }}" aria-label="Trip photo gallery"><div class="trip-gallery-shell"><div class="trip-gallery-head"><div><h2>Photo Gallery</h2><p class="trip-gallery-count">Photos</p></div><button class="trip-gallery-close" type="button" aria-label="Close gallery">&times;</button></div><div class="trip-gallery-scroll"><div class="trip-gallery-board" id="tripGalleryBoard"></div><p class="trip-gallery-empty" hidden>No gallery photos found.</p></div><div class="trip-gallery-viewer" aria-live="polite"><div class="trip-gallery-viewer-top"><button class="trip-gallery-viewer-btn trip-gallery-viewer-back" type="button" aria-label="Back to gallery">&times;</button><div class="trip-gallery-viewer-count"></div><button class="trip-gallery-viewer-btn trip-gallery-viewer-close" type="button" aria-label="Close gallery">&times;</button></div><div class="trip-gallery-stage"><button class="trip-gallery-viewer-btn trip-gallery-prev" type="button" aria-label="Previous photo">&#8249;</button><div class="trip-gallery-frame"><img alt=""></div><button class="trip-gallery-viewer-btn trip-gallery-next" type="button" aria-label="Next photo">&#8250;</button></div><div class="trip-gallery-caption"></div></div></div></dialog>
<script>window.__COMPOSER_MAP_POINTS__={{ combo.mapPoints | jsonForScript | safe }};</script><script src="https://unpkg.com/leaflet@1.9.4/dist/leaflet.js"></script><script src="../../assets/js/composer-shell.js?v=20260712-parity-2" defer></script><script src="../../assets/js/itinerary.js?v=20260710-gallery-full" defer></script></body></html>
