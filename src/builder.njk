---
pagination:
  data: composer.combos
  size: 1
  alias: combo
permalink: "/locations/{{ combo.slug }}/index.html"
---
{%- from "itinerary/macros.njk" import day -%}
<!doctype html><html lang="en"><head><meta charset="utf-8"><meta name="viewport" content="width=device-width,initial-scale=1"><title>{{ combo.title }}</title><link rel="stylesheet" href="../../assets/css/itinerary.css?v=20260710-travel-frame-all"><style>
body{background:#f5f0e7;color:#24231f}.composer-shell{max-width:1320px;margin:auto;padding:24px}.draft-banner{padding:14px 18px;border-radius:12px;background:#fff1c9;border:1px solid #d7a93f;line-height:1.5}.preview{margin:22px 0}.pvcar{display:grid;grid-template-columns:repeat(3,1fr);gap:8px}.pvcar figure{margin:0;height:250px}.pvcar img{width:100%;height:100%;object-fit:cover;border-radius:12px}.composer-table{width:100%;border-collapse:collapse;background:#fff;border-radius:12px;overflow:hidden}.composer-table th,.composer-table td{padding:10px 12px;border-bottom:1px solid #ddd;text-align:left}.composer-score-grid{display:grid;grid-template-columns:repeat(auto-fit,minmax(130px,1fr));gap:8px;margin:20px 0}.composer-score-grid div,.composer-map-grid a{padding:12px;background:#fff;border:1px solid #ddd;border-radius:10px}.composer-score-grid b,.composer-score-grid span,.composer-map-grid span{display:block}.composer-map-grid{display:grid;grid-template-columns:repeat(auto-fit,minmax(220px,1fr));gap:8px}.composer-map-grid a{text-decoration:none;color:inherit}@media(max-width:700px){.pvcar{grid-template-columns:1fr 1fr}.pvcar figure{height:180px}}
</style></head><body><main class="composer-shell" data-trip-slug="{{ combo.slug }}">
<p><a href="../../index.html">← All trips</a></p>
<div class="draft-banner"><strong>DRAFT</strong> — composed from {% for ref in combo.sourceRefs %}<a href="../{{ ref }}/">{{ ref }}</a>{% if not loop.last %}, {% endif %}{% endfor %}. Scores and budgets are estimated, not evidence-audited, and this draft is not on the scoreboard.</div>
<header><p class="eyebrow">Build-time Trip Composer</p><h1>{{ combo.title }}</h1><p>{{ combo.totalNights }} nights · {{ combo.departDate }} to {{ combo.returnDate }} · estimated {{ combo.scorecard.totalBaked }}/50</p></header>
<section class="preview"><div class="pvcar">{% for image in combo.heroImages %}<figure><img src="{{ image.src | safe }}" alt="{{ image.alt | safe }}" loading="{% if loop.first %}eager{% else %}lazy{% endif %}"><figcaption>{{ image.captionTitle | safe }}</figcaption></figure>{% endfor %}</div></section>
<section><div class="section-label"><p class="eyebrow">Estimated scorecard</p><h2>{{ combo.scorecard.totalBaked }}/50 planning estimate</h2><p>PTO: {{ combo.scorecard.pto.days }} days. These axes are deterministic estimates, not audited evidence.</p></div><div class="composer-score-grid">{% for id, value in combo.scorecard.axes %}<div><b>{{ value }}/5</b><span>{{ id }}</span></div>{% endfor %}</div></section>
<section id="itinerary" class="itinerary composed-itinerary"><div class="section-label">{{ combo.itinerary.labelHtml | safe }}</div><div class="days">{% for d in combo.itinerary.days %}{{ day(d) }}{% endfor %}</div></section>
{% include "itinerary/composed-map.njk" %}
<section><div class="section-label"><p class="eyebrow">Estimated budget</p><h2>${{ combo.budget.floorUsd }}–${{ combo.budget.ceilUsd }}</h2></div><table class="composer-table"><tbody>{% for row in combo.budgetRows %}<tr id="{{ row.id }}"><th>{{ row.label }}</th><td>${{ row.floorUsd }}–${{ row.ceilUsd }}</td></tr>{% endfor %}</tbody></table></section>
<section><div class="section-label"><p class="eyebrow">Transfer watch</p><h2>{{ combo.transfer.mode }} · {{ combo.transfer.hours }} hours</h2><p>{{ combo.transfer.watch }}</p></div></section>
</main><script src="../../assets/js/itinerary.js?v=20260710-gallery-full" defer></script></body></html>
