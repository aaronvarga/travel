---
pagination:
  data: trips
  size: 1
  alias: trip
permalink: "/locations/{{ trip.slug }}/index.html"
---
{%- macro carousel(spot) -%}
{%- set n = spot.images | length -%}
<div class="carousel" id="{{ spot.carouselId }}" data-n="{{ n }}"><div class="track">{% for img in spot.images %}<figure>{% if img.href %}<a href="{{ img.href | safe }}" target="_blank" rel="noreferrer"><img src="{{ img.src | safe }}" alt="{{ img.alt | safe }}" loading="lazy"></a>{% else %}<img src="{{ img.src | safe }}" alt="{{ img.alt | safe }}" loading="lazy">{% endif %}<figcaption><strong>{{ img.captionTitle | safe }}</strong><span>{{ img.credit | safe }}</span></figcaption></figure>{% endfor %}</div><button class="nav prev" aria-label="Previous">‹</button><button class="nav next" aria-label="Next">›</button><div class="counter"><span class="cur">1</span> / {{ n }}</div><div class="dots">{% for img in spot.images %}<button class="dot" data-i="{{ loop.index0 }}" aria-label="Photo {{ loop.index }}"></button>{% endfor %}</div></div>
{%- endmacro -%}

{%- macro spot(s) -%}
<section class="spot">
      <div class="spot-head">
        <div><h4 class="spot-name">{{ s.name | safe }}</h4>{% if s.alltrailsTrail %}<a class="at-badge" href="{{ s.alltrailsTrail | safe }}" target="_blank" rel="noreferrer" title="Open this trail on AllTrails">AllTrails</a>{% endif %}</div>
        <div class="explore">{{ s.exploreHtml | safe }}{% if s.alltrailsArea %}<a class="xg at-xg" href="{{ s.alltrailsArea | safe }}" target="_blank" rel="noreferrer">AllTrails</a>{% endif %}</div>
      </div>
      {{ carousel(s) }}
      {%- if s.rawAfterCarousel -%}{{ s.rawAfterCarousel | safe }}{%- else -%}
      <div class="spot-grid">
        <div class="spot-info">
          <div class="kv"><span>Cost</span><p>{{ s.cost | safe }}</p></div><div class="kv climate"><span>{{ s.climateLabel | safe }}</span><p>{{ s.climate | safe }}</p></div>
          <div class="callout save">{{ s.saveHtml | safe }}</div>
          <div class="callout splurge">{{ s.splurgeHtml | safe }}</div>
          <div class="resto">
            <p class="mini-h">Family &amp; picky-kid eats</p>
            <ul>{{ s.restoHtml | safe }}</ul>
          </div>
          <details class="altbox">
            <summary class="mini-h">Also awesome instead / if you have time</summary>
            {{ s.altboxHtml | safe }}
          </details>
          <div class="bloglinks"><p class="mini-h">Travel-blog tips</p>{{ s.bloglinksHtml | safe }}</div>
        </div>
        {{ s.spotMapHtml | safe }}
      </div>
      {%- endif -%}
    </section>
{%- endmacro -%}

{%- macro day(d) -%}
<article class="day {{ d.colorClass }}" id="{{ d.id }}">
      <div class="day-head">
        <div class="day-badge">{{ d.badge | safe }}</div>
        <div class="day-title"><p class="eyebrow">{{ d.eyebrow | safe }}</p><h3>{{ d.heading | safe }}</h3><p class="feel">{{ d.feel | safe }}</p><p class="daycost">{{ d.daycost | safe }}</p></div>
      </div>
      <div class="logistics">
        <div class="facts">{% for f in d.facts %}<div><span>{{ f.label | safe }}</span><strong>{{ f.valueHtml | safe }}</strong></div>{% endfor %}</div>
        <p class="note">{{ d.note | safe }}</p>
      </div>
      <div class="spots-wrap">{% if d.travelNote %}<div class="travel-note">{{ d.travelNote | safe }}</div>{% else %}{% for s in d.spots %}{{ spot(s) }}{% endfor %}{% endif %}</div>
    </article>
{%- endmacro -%}

{%- macro itinerary(it) -%}
<section id="itinerary" class="{{ it.className }}">
      <style>.spot-head .spot-name{display:inline;vertical-align:middle}a.at-badge{display:inline-flex;align-items:center;gap:.3em;margin-left:.5em;padding:.16em .6em;font-size:.6rem;font-weight:700;line-height:1;letter-spacing:.03em;text-transform:uppercase;vertical-align:middle;border-radius:999px;background:#428813;color:#fff;text-decoration:none;white-space:nowrap}a.at-badge:hover{background:#356e0f}.explore a.at-xg{background:#428813;color:#fff}.altbox summary.mini-h{cursor:pointer;margin:0;color:var(--c1)}.altbox[open] summary.mini-h{margin-bottom:8px}.altbox .alt-list{margin:0;padding:0;list-style:none;display:grid;gap:8px}.altbox .alt-list li{font-size:.86rem;color:var(--muted);line-height:1.45;padding-left:14px;position:relative}.altbox .alt-list li::before{content:"";position:absolute;left:0;top:8px;width:6px;height:6px;border-radius:50%;background:var(--c1)}.altbox .alt-list a{text-decoration:none}.altbox .alt-list .explore{margin-top:6px}.altbox .alt-list .explore a{color:#fff}.altbox .alt-list b{color:var(--ink)}</style>
      <div class="section-label">{{ it.labelHtml | safe }}</div>
      <div class="{{ it.daysClass }}">{% for d in it.days %}{{ day(d) }}{% endfor %}</div>
    </section>
{%- endmacro -%}

{%- macro todo(td) -%}
<section id="todo" class="divider pretrip-todo">
      <style>.pretrip-todo .todo-grid{display:grid;gap:12px}.pretrip-todo .todo-block{display:grid;grid-template-columns:minmax(150px,220px) minmax(0,1fr);column-gap:22px;row-gap:6px;width:100%;background:var(--card);border:1px solid var(--line);border-left:5px solid var(--c1);border-radius:12px;padding:16px 18px;box-shadow:0 10px 28px rgba(30,32,28,.08)}.pretrip-todo .todo-block.hot{border-left-color:#c0392b}.pretrip-todo .todo-block.watch{border-left-color:var(--gold)}.pretrip-todo .todo-block.done{border-left-color:var(--c3)}.pretrip-todo .todo-when{grid-row:1/4;align-self:start;display:inline-block;margin:0;padding:4px 10px;border-radius:999px;background:rgba(31,111,120,.1);color:var(--c1);font-size:.72rem;font-weight:900;letter-spacing:.06em;text-transform:uppercase;text-align:center}.pretrip-todo .todo-block.hot .todo-when{background:rgba(192,57,43,.1);color:#a23625}.pretrip-todo .todo-block.watch .todo-when{background:rgba(217,164,65,.16);color:#8a641e}.pretrip-todo .todo-block.done .todo-when{background:rgba(63,125,78,.12);color:var(--c3)}.pretrip-todo h3{grid-column:2;margin:0;font-size:1.12rem;font-weight:600;line-height:1.18}.pretrip-todo .todo-note{grid-column:2;margin:0;color:var(--muted);font-size:.9rem;line-height:1.5}.pretrip-todo ul{grid-column:2;margin:4px 0 0;padding:0;list-style:none;display:grid;gap:8px}.pretrip-todo li{position:relative;padding-left:16px;color:var(--muted);font-size:.88rem;line-height:1.45}.pretrip-todo li::before{content:"";position:absolute;left:0;top:8px;width:6px;height:6px;border-radius:50%;background:var(--gold)}.pretrip-todo li b{color:var(--ink)}.pretrip-todo .todo-callout{margin-top:18px;padding:16px 18px;border:1px solid var(--line);border-left:5px solid var(--c2);border-radius:12px;background:var(--card);box-shadow:0 10px 28px rgba(30,32,28,.08);color:var(--muted);font-size:.9rem;line-height:1.55}.pretrip-todo .todo-callout b{color:var(--ink)}@media(max-width:720px){.pretrip-todo .todo-block{grid-template-columns:1fr;padding:16px}.pretrip-todo .todo-when{grid-row:auto;justify-self:start;text-align:left}.pretrip-todo h3,.pretrip-todo .todo-note,.pretrip-todo ul{grid-column:1}}</style>
      <div class="section-label">{{ td.labelHtml | safe }}</div>
      <div class="todo-grid">{% for block in td.blocks %}
        <article class="todo-block{% if block.tone %} {{ block.tone }}{% endif %}">
          <p class="todo-when">{{ block.when | safe }}</p>
          <h3>{{ block.title | safe }}</h3>
          {%- if block.note %}<p class="todo-note">{{ block.note | safe }}</p>{% endif %}
          <ul>{% for item in block.items %}<li>{{ item | safe }}</li>{% endfor %}</ul>
        </article>{% endfor %}
      </div>
      {% if td.callout %}<div class="todo-callout">{{ td.callout | safe }}</div>{% endif %}
    </section>
{%- endmacro -%}

{%- macro entry(main, countries) -%}
<section id="entry" class="divider">
      <style>#entry .entry-list{margin:6px 0 0;padding:0;list-style:none;display:grid;gap:6px}#entry .entry-list li{font-size:.86rem;color:var(--muted);line-height:1.45}#entry .entry-list li b{color:var(--ink)}#entry .sources{margin-top:6px;font-size:.76rem;color:var(--muted)}#entry .sources a{color:var(--c1)}</style>
      <div class="section-label">
        <p class="eyebrow">Entry &amp; Documents</p>
        <h2>Passports and essentials</h2>
        <p>Documents, driving, money, health, and connectivity for this trip. Time-sensitive items (especially <b>ETIAS</b>) can change — re-check the linked official sources close to departure.</p>
      </div>
      <div class="plan-grid">
      {%- for slug in main.countries -%}{%- set c = countries[slug] -%}{%- if c -%}
        <div class="pcard">
          <h4><span class="dot"></span>{{ c.name | safe }}</h4>
          {% if c.passportRule %}<div class="prow"><span>Passport</span><strong>{{ c.passportRule | safe }}</strong></div>{% endif %}
          {% if c.etias and c.etias.status %}<div class="prow"><span>ETIAS</span><strong>{{ c.etias.status | safe }}{% if c.etias.fee %} — {{ c.etias.fee | safe }}{% endif %}</strong></div>{% endif %}
          {% if c.visa %}<div class="prow"><span>Visa</span><strong>{{ c.visa | safe }}</strong></div>{% endif %}
          {% if c.idp %}<div class="prow"><span>Driving permit</span><strong>{{ c.idp | safe }}</strong></div>{% endif %}
          {% if c.driving %}<div class="prow"><span>Rental cars</span><strong>{{ c.driving | safe }}</strong></div>{% endif %}
          {% if c.tolls %}<div class="prow"><span>Tolls</span><strong>{{ c.tolls | safe }}</strong></div>{% endif %}
          {% if c.ztl %}<div class="prow"><span>ZTL warning</span><strong>{{ c.ztl | safe }}</strong></div>{% endif %}
          {% if c.money %}<div class="prow"><span>Money</span><strong>{{ c.money.cards | safe }} {{ c.money.cash | safe }}</strong></div><div class="prow"><span>Tipping</span><strong>{{ c.money.tipping | safe }}</strong></div>{% endif %}
          {% if c.water %}<div class="prow"><span>Tap water</span><strong>{{ c.water | safe }}</strong></div>{% endif %}
          {% if c.emergency %}<div class="prow"><span>Emergency</span><strong>{{ c.emergency | safe }}</strong></div>{% endif %}
          {% if c.esim %}<div class="prow"><span>Connectivity</span><strong>{{ c.esim | safe }}</strong></div>{% endif %}
          {% if c.etias and c.etias.note %}<div class="tip">{{ c.etias.note | safe }}</div>{% endif %}
          {% if c.sources %}<p class="sources">Sources: {% for s in c.sources %}<a href="{{ s.url | safe }}" target="_blank" rel="noreferrer">{{ s.label | safe }}</a>{% if not loop.last %} · {% endif %}{% endfor %}</p>{% endif %}
        </div>
      {%- endif -%}{%- endfor -%}
        <div class="pcard">
          <h4><span class="dot"></span>Travel insurance</h4>
          <div class="prow"><span>Recommend</span><strong>Family travel-medical + trip-cancellation policy</strong></div>
          <div class="prow"><span>Coverage</span><strong>Medical/evacuation, trip interruption, baggage; check that activities (boats, hikes) are included</strong></div>
          <div class="tip">Buy within ~14 days of the first trip deposit to keep pre-existing-condition waivers available. Carry the policy number and the insurer's 24-hour assistance line offline.</div>
        </div>
      </div>
    </section>
{%- endmacro -%}

{%- macro packing(main, packing) -%}
<section id="packing" class="divider">
      <style>#packing .pack-list{margin:6px 0 0;padding:0;list-style:none;display:grid;gap:7px}#packing .pack-list li{position:relative;padding-left:16px;font-size:.86rem;color:var(--muted);line-height:1.45}#packing .pack-list li::before{content:"";position:absolute;left:0;top:8px;width:6px;height:6px;border-radius:50%;background:var(--c1)}#packing .pack-list li b{color:var(--ink)}</style>
      <div class="section-label">
        <p class="eyebrow">Packing</p>
        <h2>What to bring</h2>
        <p>A family baseline that holds for every trip, plus items tuned to this route's conditions.</p>
      </div>
      <div class="plan-grid">
        <div class="pcard"><h4><span class="dot"></span>Family baseline</h4><ul class="pack-list">{% for i in packing.base %}<li>{{ i | safe }}</li>{% endfor %}</ul></div>
        {%- for tag in main.packingTags -%}{%- set mod = packing.modifiers[tag] -%}{%- if mod -%}
        <div class="pcard"><h4><span class="dot"></span>{{ mod.label | safe }}</h4><ul class="pack-list">{% for i in mod.items %}<li>{{ i | safe }}</li>{% endfor %}</ul></div>
        {%- endif -%}{%- endfor -%}
        {%- if main.overrides and main.overrides.packing -%}
        <div class="pcard"><h4><span class="dot"></span>This trip specifically</h4><ul class="pack-list">{% for i in main.overrides.packing %}<li>{{ i | safe }}</li>{% endfor %}</ul></div>
        {%- endif -%}
      </div>
    </section>
{%- endmacro -%}
{%- for part in trip.main.parts -%}
{%- if part.t == "raw" -%}{{ part.html | safe }}
{%- elif part.t == "itinerary" -%}{{ itinerary(trip.main.itinerary) }}
{%- elif part.t == "todo" -%}{% if trip.main.preDepartureTodos %}{{ todo(trip.main.preDepartureTodos) }}{% endif %}
{%- elif part.t == "entry" -%}{{ entry(trip.main, shared.countries) }}
{%- elif part.t == "packing" -%}{{ packing(trip.main, shared.packing) }}
{%- elif part.t == "photoGuide" -%}{{ trip.photoGuide.html | safe }}
{%- elif part.t == "foodGuide" -%}{{ trip.foodGuide.html | safe }}
{%- elif part.t == "lib" -%}<script>{{ chrome.leafletLibs[part.key] | safe }}</script>
{%- endif -%}
{%- endfor -%}
<style>
  /* Phase 7 — print/PDF degradation for itineraries. Scoped with @media print
     (NOT just a media="print" attribute): this <style> is emitted after </html>
     and reparented into the body, where the media attribute is not reliably
     honored — the @media block guarantees these rules never touch the screen. */
  @media print {
    @page { margin: 14mm; }
    .site-nav, .site-nav-menu { display: none !important; }
    /* Carousels: reveal every photo, stacked; drop interactive chrome. */
    .carousel { height: auto !important; overflow: visible !important; }
    .carousel .track { display: block !important; transform: none !important; overflow: visible !important; width: auto !important; }
    .carousel figure { display: block !important; width: 100% !important; break-inside: avoid; margin: 0 0 8px !important; }
    .carousel figure img { max-height: 320px; width: auto !important; max-width: 100% !important; object-fit: contain !important; }
    .carousel .nav, .carousel .counter, .carousel .dots { display: none !important; }
    /* Maps: drop interactive controls; keep the loaded tile snapshot; the Google
       Maps link remains as a printed fallback reference. */
    .leaflet-control-container, .mapbtns, .leaflet-control-zoom { display: none !important; }
    .mapstage, .mapwrap { break-inside: avoid; }
    [class$="-map-embed"], .mapstage { max-height: 360px !important; }
    a.gmap, .gmap-btn { text-decoration: underline; }
    /* Keep logical blocks intact across page breaks. */
    .day, .spot, .pcard, .todo-block, .winner-card, .hc, section { break-inside: avoid; }
    section { page-break-inside: avoid; }
    details { display: block !important; }
    details:not([open]) > *:not(summary) { display: revert !important; }
    a[href] { color: inherit; }
  }
</style>
<script>
  /* Force-load lazy images and open <details> before printing so nothing is
     blank or collapsed in the PDF. */
  (function () {
    function prep() {
      document.querySelectorAll('img[loading="lazy"]').forEach(function (img) {
        img.loading = 'eager';
        if (img.dataset && img.dataset.src && !img.src) img.src = img.dataset.src;
      });
      document.querySelectorAll('details').forEach(function (d) { d.open = true; });
    }
    window.addEventListener('beforeprint', prep);
    if (window.matchMedia) {
      try { window.matchMedia('print').addEventListener('change', function (e) { if (e.matches) prep(); }); } catch (e) {}
    }
  })();
</script>
<script>
  /* Phase 8 — register the offline service worker (root scope) for on-trip use. */
  if ('serviceWorker' in navigator) {
    window.addEventListener('load', function () {
      var p = location.pathname, i = p.indexOf('/locations/');
      var root = i >= 0 ? p.slice(0, i + 1) : p.replace(/[^/]*$/, '');
      navigator.serviceWorker.register(root + 'sw.js', { scope: root }).catch(function () {});
    });
  }
</script>
