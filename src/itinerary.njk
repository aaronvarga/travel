---
pagination:
  data: trips
  size: 1
  alias: trip
permalink: "/locations/{{ trip.slug }}/index.html"
---
{%- macro carousel(spot) -%}
{%- set n = spot.images | length -%}
<div class="carousel" id="{{ spot.carouselId }}" data-n="{{ n }}"><div class="track">{% for img in spot.images %}<figure>{% if img.href %}<a href="{{ img.href | safe }}" target="_blank" rel="noreferrer"><img src="{{ img.src | safe }}" alt="{{ img.alt | safe }}" loading="lazy"></a>{% else %}<img src="{{ img.src | safe }}" alt="{{ img.alt | safe }}" loading="lazy">{% endif %}<figcaption><strong>{{ img.captionTitle | safe }}</strong><span>{{ img.credit | safe }}</span></figcaption></figure>{% endfor %}</div><button class="nav prev" aria-label="Previous">‹</button><button class="nav next" aria-label="Next">›</button><div class="counter"><span class="cur">1</span> / {{ n }}</div><div class="dots">{% for img in spot.images %}<button class="dot" data-i="{{ loop.index0 }}" aria-label="Photo {{ loop.index }}"></button>{% endfor %}</div></div>
{%- endmacro -%}

{%- macro spot(s) -%}
<section class="spot">
      <div class="spot-head">
        <div><h4 class="spot-name">{{ s.name | safe }}</h4>{% if s.alltrailsTrail %}<a class="at-badge" href="{{ s.alltrailsTrail | safe }}" target="_blank" rel="noreferrer" title="Open this trail on AllTrails">AllTrails</a>{% endif %}</div>
        <div class="explore">{{ s.exploreHtml | safe }}{% if s.alltrailsArea %}<a class="xg at-xg" href="{{ s.alltrailsArea | safe }}" target="_blank" rel="noreferrer">AllTrails</a>{% endif %}</div>
      </div>
      {{ carousel(s) }}
      {%- if s.rawAfterCarousel -%}{{ s.rawAfterCarousel | safe }}{%- else -%}
      <div class="spot-grid">
        <div class="spot-info">
          <div class="kv"><span>Cost</span><p>{{ s.cost | safe }}</p></div><div class="kv climate"><span>{{ s.climateLabel | safe }}</span><p>{{ s.climate | safe }}</p></div>
          <div class="callout save">{{ s.saveHtml | safe }}</div>
          <div class="callout splurge">{{ s.splurgeHtml | safe }}</div>
          <div class="resto">
            <p class="mini-h">Family &amp; picky-kid eats</p>
            <ul>{{ s.restoHtml | safe }}</ul>
          </div>
          <details class="altbox">
            <summary class="mini-h">Also awesome instead / if you have time</summary>
            {{ s.altboxHtml | safe }}
          </details>
          <div class="bloglinks"><p class="mini-h">Travel-blog tips</p>{{ s.bloglinksHtml | safe }}</div>
        </div>
        {{ s.spotMapHtml | safe }}
      </div>
      {%- endif -%}
    </section>
{%- endmacro -%}

{%- macro day(d) -%}
<article class="day {{ d.colorClass }}" id="{{ d.id }}">
      <div class="day-head">
        <div class="day-badge">{{ d.badge | safe }}</div>
        <div class="day-title"><p class="eyebrow">{{ d.eyebrow | safe }}</p><h3>{{ d.heading | safe }}</h3><p class="feel">{{ d.feel | safe }}</p><p class="daycost">{{ d.daycost | safe }}</p></div>
      </div>
      <div class="logistics">
        <div class="facts">{% for f in d.facts %}<div><span>{{ f.label | safe }}</span><strong>{{ f.valueHtml | safe }}</strong></div>{% endfor %}</div>
        <p class="note">{{ d.note | safe }}</p>
      </div>
      <div class="spots-wrap">{% if d.travelNote %}<div class="travel-note">{{ d.travelNote | safe }}</div>{% else %}{% for s in d.spots %}{{ spot(s) }}{% endfor %}{% endif %}</div>
    </article>
{%- endmacro -%}

{%- macro itinerary(it) -%}
<section id="itinerary" class="{{ it.className }}">
      <style>
        .spot-head .spot-name{display:inline;vertical-align:middle}a.at-badge{display:inline-flex;align-items:center;gap:.3em;margin-left:.5em;padding:.16em .6em;font-size:.6rem;font-weight:700;line-height:1;letter-spacing:.03em;text-transform:uppercase;vertical-align:middle;border-radius:999px;background:#428813;color:#fff;text-decoration:none;white-space:nowrap}a.at-badge:hover{background:#356e0f}.explore a.at-xg{background:#428813;color:#fff}.altbox summary.mini-h{cursor:pointer;margin:0;color:var(--c1)}.altbox[open] summary.mini-h{margin-bottom:8px}.altbox .alt-list{margin:0;padding:0;list-style:none;display:grid;gap:8px}.altbox .alt-list li{font-size:.86rem;color:var(--muted);line-height:1.45;padding-left:14px;position:relative}.altbox .alt-list li::before{content:"";position:absolute;left:0;top:8px;width:6px;height:6px;border-radius:50%;background:var(--c1)}.altbox .alt-list a{text-decoration:none}.altbox .alt-list .explore{margin-top:6px}.altbox .alt-list .explore a{color:#fff}.altbox .alt-list b{color:var(--ink)}
        .day-dock{position:fixed;z-index:480;left:50%;bottom:calc(12px + env(safe-area-inset-bottom));width:min(680px,calc(100vw - 24px));padding:9px 0 10px;border:0;background:transparent;box-shadow:none;opacity:0;visibility:hidden;pointer-events:none;transform:translate(-50%,18px);transition:opacity .1s ease,transform .14s cubic-bezier(.2,.8,.2,1),visibility 0s linear .14s;color:#f6f1e7}
        .day-dock.is-visible{opacity:1;visibility:visible;pointer-events:auto;transform:translate(-50%,0);transition-delay:0s}
        .day-dock-caption{min-height:34px;padding:0 6px 7px;overflow:hidden;text-align:center;text-shadow:0 2px 8px rgba(0,0,0,.92);white-space:nowrap;text-overflow:ellipsis}
        .day-dock-caption span{display:block;color:rgba(246,241,231,.62);font-size:.62rem;font-weight:900;letter-spacing:.11em;text-transform:uppercase}
        .day-dock-caption strong{display:block;overflow:hidden;color:#fff;font-family:"Fraunces","Georgia",serif;font-size:.9rem;font-weight:600;line-height:1.2;text-overflow:ellipsis}
        .day-dock-track{display:flex;align-items:center;gap:6px;overflow-x:auto;padding:3px 4px 5px;scrollbar-width:none;overscroll-behavior-x:contain;-webkit-overflow-scrolling:touch}
        .day-dock-track::-webkit-scrollbar{display:none}
        .day-dock-item{position:relative;display:block;flex:0 0 auto;width:var(--dock-size,40px);height:var(--dock-size,40px);border:1px solid rgba(255,255,255,.3);border-radius:12px;background:#2a231b;color:#fff;box-shadow:0 5px 14px rgba(0,0,0,.24);overflow:visible;text-decoration:none;transition:width .07s linear,height .07s linear,border-color .07s ease,box-shadow .07s ease;isolation:isolate}
        .day-dock-item:hover,.day-dock-item:focus-visible,.day-dock-item[aria-current="step"]{border-color:rgba(255,255,255,.88);box-shadow:0 8px 22px rgba(0,0,0,.36),0 0 0 2px rgba(95,154,163,.62)}
        .day-dock-item:focus-visible{outline:2px solid #fff;outline-offset:3px}
        .day-dock-thumb{position:absolute;inset:0;display:grid;place-items:center;overflow:hidden;border-radius:11px;background:radial-gradient(circle at 28% 22%,rgba(95,154,163,.92),rgba(31,66,72,.98) 72%);background-position:center;background-size:cover}
        .day-dock-thumb::after{content:"";position:absolute;inset:0;background:linear-gradient(180deg,transparent 45%,rgba(8,14,18,.72));pointer-events:none}
        .day-dock-item.has-photo .day-dock-fallback{display:none}
        .day-dock-fallback{position:relative;z-index:1;width:46%;height:46%;filter:drop-shadow(0 2px 4px rgba(0,0,0,.3))}
        .day-dock-number{position:absolute;z-index:2;right:3px;bottom:3px;display:grid;place-items:center;min-width:18px;height:18px;padding:0 4px;border:1px solid rgba(255,255,255,.48);border-radius:999px;background:rgba(17,14,11,.82);color:#fff;font-size:.59rem;font-weight:900;line-height:1}
        .day-dock-tooltip{display:none}
        @media(min-width:1180px){
          .day-dock{left:auto;right:clamp(10px,1.5vw,24px);bottom:auto;top:50%;width:auto;max-height:calc(100vh - 28px);padding:8px 0;transform:translate(22px,-50%)}
          .day-dock.is-visible{transform:translate(0,-50%)}
          .day-dock-caption{display:none}
          .day-dock-track{flex-direction:column;align-items:flex-end;gap:5px;max-height:calc(100vh - 44px);padding:4px;overflow:visible}
          .day-dock-tooltip{position:absolute;right:calc(100% + 13px);top:50%;display:block;width:270px;padding:10px 12px;border:1px solid rgba(246,241,231,.18);border-radius:11px;background:rgba(23,19,15,.96);box-shadow:0 12px 32px rgba(12,10,8,.32);opacity:0;visibility:hidden;pointer-events:none;transform:translate(9px,-50%);transition:opacity .07s ease,transform .1s ease,visibility 0s linear .1s;text-align:left}
          .day-dock-tooltip::after{content:"";position:absolute;left:100%;top:50%;border:6px solid transparent;border-left-color:rgba(23,19,15,.96);transform:translateY(-50%)}
          .day-dock-item:hover .day-dock-tooltip,.day-dock-item:focus-visible .day-dock-tooltip{opacity:1;visibility:visible;transform:translate(0,-50%);transition-delay:0s}
          .day-dock-tooltip span,.day-dock-tooltip small{display:block;color:rgba(246,241,231,.62);font-size:.62rem;font-weight:900;letter-spacing:.09em;text-transform:uppercase}
          .day-dock-tooltip strong{display:block;margin:2px 0;color:#fff;font-family:"Fraunces","Georgia",serif;font-size:.92rem;font-weight:600;line-height:1.2}
          .day-dock-tooltip small{overflow:hidden;font-weight:700;letter-spacing:.02em;text-overflow:ellipsis;text-transform:none;white-space:nowrap}
        }
        html.day-dock-fast-scroll{scroll-behavior:auto!important}
        @media(prefers-reduced-motion:reduce){.day-dock,.day-dock-item,.day-dock-tooltip{transition:none!important}.day-dock-track{scroll-behavior:auto}}
        @media print{.day-dock{display:none!important}}
      </style>
      <div class="section-label">{{ it.labelHtml | safe }}</div>
      <nav class="day-dock" aria-label="Jump to an itinerary day" hidden>
        <svg width="0" height="0" aria-hidden="true" focusable="false" style="position:absolute">
          <symbol id="day-dock-icon-plane" viewBox="0 0 24 24"><path fill="none" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17.8 19.2 16 11l3.5-3.5C21 6 21.5 4 21 3c-1-.5-3 0-4.5 1.5L13 8 4.8 6.2c-.5-.1-.9.1-1.1.5l-.3.5c-.2.5-.1 1 .3 1.3L9 12l-2 3H4l-1 1 3 2 2 3 1-1v-3l3-2 3.5 5.3c.3.4.8.5 1.3.3l.5-.2c.4-.3.6-.7.5-1.2Z"/></symbol>
          <symbol id="day-dock-icon-car" viewBox="0 0 24 24"><g fill="none" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" stroke-width="2"><path d="m21 8-2 2-1.5-3.7A2 2 0 0 0 15.65 5H8.4a2 2 0 0 0-1.9 1.26L5 10 3 8m4 6h.01M17 14h.01"/><rect width="18" height="8" x="3" y="10" rx="2"/><path d="M5 18v2m14-2v2"/></g></symbol>
          <symbol id="day-dock-icon-ship" viewBox="0 0 24 24"><g fill="none" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" stroke-width="2"><path d="M12 10.19V14m0-12v3m7 8V7a2 2 0 0 0-2-2H7a2 2 0 0 0-2 2v6"/><path d="M19.38 20A11.6 11.6 0 0 0 21 14l-8.19-3.64a2 2 0 0 0-1.62 0L3 14a11.6 11.6 0 0 0 2.81 7.76"/><path d="M2 21c.6.5 1.2 1 2.5 1 2.5 0 2.5-2 5-2 1.3 0 1.9.5 2.5 1s1.2 1 2.5 1c2.5 0 2.5-2 5-2 1.3 0 1.9.5 2.5 1"/></g></symbol>
          <symbol id="day-dock-icon-map" viewBox="0 0 24 24"><g fill="none" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" stroke-width="2"><path d="M20 10c0 4.99-5.54 10.19-7.4 11.8a1 1 0 0 1-1.2 0C9.54 20.19 4 14.99 4 10a8 8 0 0 1 16 0"/><circle cx="12" cy="10" r="3"/></g></symbol>
        </svg>
        <div class="day-dock-caption" aria-hidden="true"><span></span><strong></strong></div>
        <div class="day-dock-track">{% for d in it.days %}
          <a class="day-dock-item" href="#{{ d.id }}" data-day-id="{{ d.id }}" aria-label="Jump to day {{ d.badge }}">
            <span class="day-dock-thumb" aria-hidden="true"><svg class="day-dock-fallback" viewBox="0 0 24 24"><use href="#day-dock-icon-map"></use></svg><span class="day-dock-number">{{ d.badge | safe }}</span></span>
            <span class="day-dock-tooltip"><span>{{ d.eyebrow | safe }} · Day {{ d.badge | safe }}</span><strong>{{ d.heading | safe }}</strong><small>{{ d.feel | safe }}</small></span>
          </a>{% endfor %}
        </div>
      </nav>
      <div class="{{ it.daysClass }}">{% for d in it.days %}{{ day(d) }}{% endfor %}</div>
    </section>
{%- endmacro -%}

{%- macro todo(td) -%}
<section id="todo" class="divider pretrip-todo">
      <style>.pretrip-todo .todo-grid{display:grid;gap:12px}.pretrip-todo .todo-block{display:grid;grid-template-columns:minmax(150px,220px) minmax(0,1fr);column-gap:22px;row-gap:6px;width:100%;background:var(--card);border:1px solid var(--line);border-left:5px solid var(--c1);border-radius:12px;padding:16px 18px;box-shadow:0 10px 28px rgba(30,32,28,.08)}.pretrip-todo .todo-block.hot{border-left-color:#c0392b}.pretrip-todo .todo-block.watch{border-left-color:var(--gold)}.pretrip-todo .todo-block.done{border-left-color:var(--c3)}.pretrip-todo .todo-when{grid-row:1/4;align-self:start;display:inline-block;margin:0;padding:4px 10px;border-radius:999px;background:rgba(31,111,120,.1);color:var(--c1);font-size:.72rem;font-weight:900;letter-spacing:.06em;text-transform:uppercase;text-align:center}.pretrip-todo .todo-block.hot .todo-when{background:rgba(192,57,43,.1);color:#a23625}.pretrip-todo .todo-block.watch .todo-when{background:rgba(217,164,65,.16);color:#8a641e}.pretrip-todo .todo-block.done .todo-when{background:rgba(63,125,78,.12);color:var(--c3)}.pretrip-todo h3{grid-column:2;margin:0;font-size:1.12rem;font-weight:600;line-height:1.18}.pretrip-todo .todo-note{grid-column:2;margin:0;color:var(--muted);font-size:.9rem;line-height:1.5}.pretrip-todo ul{grid-column:2;margin:4px 0 0;padding:0;list-style:none;display:grid;gap:8px}.pretrip-todo li{position:relative;padding-left:16px;color:var(--muted);font-size:.88rem;line-height:1.45}.pretrip-todo li::before{content:"";position:absolute;left:0;top:8px;width:6px;height:6px;border-radius:50%;background:var(--gold)}.pretrip-todo li b{color:var(--ink)}.pretrip-todo .todo-callout{margin-top:18px;padding:16px 18px;border:1px solid var(--line);border-left:5px solid var(--c2);border-radius:12px;background:var(--card);box-shadow:0 10px 28px rgba(30,32,28,.08);color:var(--muted);font-size:.9rem;line-height:1.55}.pretrip-todo .todo-callout b{color:var(--ink)}@media(max-width:720px){.pretrip-todo .todo-block{grid-template-columns:1fr;padding:16px}.pretrip-todo .todo-when{grid-row:auto;justify-self:start;text-align:left}.pretrip-todo h3,.pretrip-todo .todo-note,.pretrip-todo ul{grid-column:1}}</style>
      <div class="section-label">{{ td.labelHtml | safe }}</div>
      <div class="todo-grid">{% for block in td.blocks %}
        <article class="todo-block{% if block.tone %} {{ block.tone }}{% endif %}">
          <p class="todo-when">{{ block.when | safe }}</p>
          <h3>{{ block.title | safe }}</h3>
          {%- if block.note %}<p class="todo-note">{{ block.note | safe }}</p>{% endif %}
          <ul>{% for item in block.items %}<li>{{ item | safe }}</li>{% endfor %}</ul>
        </article>{% endfor %}
      </div>
      {% if td.callout %}<div class="todo-callout">{{ td.callout | safe }}</div>{% endif %}
    </section>
{%- endmacro -%}

{%- macro entry(main, countries) -%}
<section id="entry" class="divider">
      <style>#entry .entry-list{margin:6px 0 0;padding:0;list-style:none;display:grid;gap:6px}#entry .entry-list li{font-size:.86rem;color:var(--muted);line-height:1.45}#entry .entry-list li b{color:var(--ink)}#entry .sources{margin-top:6px;font-size:.76rem;color:var(--muted)}#entry .sources a{color:var(--c1)}</style>
      <div class="section-label">
        <p class="eyebrow">Entry &amp; Documents</p>
        <h2>Passports and essentials</h2>
        <p>Documents, driving, money, health, and connectivity for this trip. Time-sensitive items (especially <b>ETIAS</b>) can change — re-check the linked official sources close to departure.</p>
      </div>
      <div class="plan-grid">
      {%- for slug in main.countries -%}{%- set c = countries[slug] -%}{%- if c -%}
        <div class="pcard">
          <h4><span class="dot"></span>{{ c.name | safe }}</h4>
          {% if c.passportRule %}<div class="prow"><span>Passport</span><strong>{{ c.passportRule | safe }}</strong></div>{% endif %}
          {% if c.etias and c.etias.status %}<div class="prow"><span>ETIAS</span><strong>{{ c.etias.status | safe }}{% if c.etias.fee %} — {{ c.etias.fee | safe }}{% endif %}</strong></div>{% endif %}
          {% if c.visa %}<div class="prow"><span>Visa</span><strong>{{ c.visa | safe }}</strong></div>{% endif %}
          {% if c.idp %}<div class="prow"><span>Driving permit</span><strong>{{ c.idp | safe }}</strong></div>{% endif %}
          {% if c.driving %}<div class="prow"><span>Rental cars</span><strong>{{ c.driving | safe }}</strong></div>{% endif %}
          {% if c.tolls %}<div class="prow"><span>Tolls</span><strong>{{ c.tolls | safe }}</strong></div>{% endif %}
          {% if c.ztl %}<div class="prow"><span>ZTL warning</span><strong>{{ c.ztl | safe }}</strong></div>{% endif %}
          {% if c.money %}<div class="prow"><span>Money</span><strong>{{ c.money.cards | safe }} {{ c.money.cash | safe }}</strong></div><div class="prow"><span>Tipping</span><strong>{{ c.money.tipping | safe }}</strong></div>{% endif %}
          {% if c.water %}<div class="prow"><span>Tap water</span><strong>{{ c.water | safe }}</strong></div>{% endif %}
          {% if c.emergency %}<div class="prow"><span>Emergency</span><strong>{{ c.emergency | safe }}</strong></div>{% endif %}
          {% if c.esim %}<div class="prow"><span>Connectivity</span><strong>{{ c.esim | safe }}</strong></div>{% endif %}
          {% if c.etias and c.etias.note %}<div class="tip">{{ c.etias.note | safe }}</div>{% endif %}
          {% if c.sources %}<p class="sources">Sources: {% for s in c.sources %}<a href="{{ s.url | safe }}" target="_blank" rel="noreferrer">{{ s.label | safe }}</a>{% if not loop.last %} · {% endif %}{% endfor %}</p>{% endif %}
        </div>
      {%- endif -%}{%- endfor -%}
        <div class="pcard">
          <h4><span class="dot"></span>Travel insurance</h4>
          <div class="prow"><span>Recommend</span><strong>Family travel-medical + trip-cancellation policy</strong></div>
          <div class="prow"><span>Coverage</span><strong>Medical/evacuation, trip interruption, baggage; check that activities (boats, hikes) are included</strong></div>
          <div class="tip">Buy within ~14 days of the first trip deposit to keep pre-existing-condition waivers available. Carry the policy number and the insurer's 24-hour assistance line offline.</div>
        </div>
      </div>
    </section>
{%- endmacro -%}

{%- macro packing(main, packing) -%}
<section id="packing" class="divider">
      <style>#packing .pack-list{margin:6px 0 0;padding:0;list-style:none;display:grid;gap:7px}#packing .pack-list li{position:relative;padding-left:16px;font-size:.86rem;color:var(--muted);line-height:1.45}#packing .pack-list li::before{content:"";position:absolute;left:0;top:8px;width:6px;height:6px;border-radius:50%;background:var(--c1)}#packing .pack-list li b{color:var(--ink)}</style>
      <div class="section-label">
        <p class="eyebrow">Packing</p>
        <h2>What to bring</h2>
        <p>A family baseline that holds for every trip, plus items tuned to this route's conditions.</p>
      </div>
      <div class="plan-grid">
        <div class="pcard"><h4><span class="dot"></span>Family baseline</h4><ul class="pack-list">{% for i in packing.base %}<li>{{ i | safe }}</li>{% endfor %}</ul></div>
        {%- for tag in main.packingTags -%}{%- set mod = packing.modifiers[tag] -%}{%- if mod -%}
        <div class="pcard"><h4><span class="dot"></span>{{ mod.label | safe }}</h4><ul class="pack-list">{% for i in mod.items %}<li>{{ i | safe }}</li>{% endfor %}</ul></div>
        {%- endif -%}{%- endfor -%}
        {%- if main.overrides and main.overrides.packing -%}
        <div class="pcard"><h4><span class="dot"></span>This trip specifically</h4><ul class="pack-list">{% for i in main.overrides.packing %}<li>{{ i | safe }}</li>{% endfor %}</ul></div>
        {%- endif -%}
      </div>
    </section>
{%- endmacro -%}
{%- for part in trip.main.parts -%}
{%- if part.t == "raw" -%}{{ part.html | safe }}
{%- elif part.t == "itinerary" -%}{{ itinerary(trip.main.itinerary) }}
{%- elif part.t == "todo" -%}{% if trip.main.preDepartureTodos %}{{ todo(trip.main.preDepartureTodos) }}{% endif %}
{%- elif part.t == "entry" -%}{{ entry(trip.main, shared.countries) }}
{%- elif part.t == "packing" -%}{{ packing(trip.main, shared.packing) }}
{%- elif part.t == "photoGuide" -%}{{ trip.photoGuide.html | safe }}
{%- elif part.t == "foodGuide" -%}{{ trip.foodGuide.html | safe }}
{%- elif part.t == "lib" -%}<script>{{ chrome.leafletLibs[part.key] | safe }}</script>
{%- endif -%}
{%- endfor -%}
{%- if trip.evidence -%}{% include "itinerary/readiness.njk" %}{% include "itinerary/evidence.njk" %}{%- endif -%}
{%- if trip.variants -%}{% include "itinerary/variants.njk" %}{%- endif -%}
<link rel="stylesheet" href="../../assets/css/itinerary.css?v=20260710-travel-frame-all">
<script src="../../assets/js/itinerary.js?v=20260710-gallery-full" defer></script>
<dialog class="trip-gallery-dialog" id="tripGalleryDialog" data-trip-slug="{{ trip.slug }}" aria-label="Trip photo gallery">
  <div class="trip-gallery-shell">
    <div class="trip-gallery-head">
      <div>
        <h2>Photo Gallery</h2>
        <p class="trip-gallery-count">Photos</p>
      </div>
      <button class="trip-gallery-close" type="button" aria-label="Close gallery">&times;</button>
    </div>
    <div class="trip-gallery-scroll">
      <div class="trip-gallery-board" id="tripGalleryBoard"></div>
      <p class="trip-gallery-empty" hidden>No gallery photos found.</p>
    </div>
    <div class="trip-gallery-viewer" aria-live="polite">
      <div class="trip-gallery-viewer-top">
        <button class="trip-gallery-viewer-btn trip-gallery-viewer-back" type="button" aria-label="Back to gallery">&times;</button>
