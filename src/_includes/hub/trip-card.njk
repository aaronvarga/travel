{%- macro tripCard(trip, shortlisted=false) -%}
<a class="sl-card{%- if trip.appealRank == 1 %} top{%- endif %}{%- if trip.slug == 'madeira-mallorca' %} madeira-stairway-card{%- endif %}" href="locations/{{ trip.slug }}/index.html"{%- if shortlisted %} data-shortlisted-trip="{{ trip.slug }}"{%- endif %}>
      <div class="sl-photo"><img src="{{ trip.heroImage }}" alt="{{ trip.cardImageAlt }}" loading="lazy"><div class="sl-rank">{%- if trip.short %}S{{ trip.shortRank }}{%- else %}#{{ trip.appealRank }}{%- endif %}</div></div>
      <div class="sl-body">
        <div class="sl-meta"><span class="sl-dates">{{ trip.travelWindow[0] | displayDate }}–{{ trip.travelWindow[1] | displayDate }}</span>{%- if not trip.short %}<span class="sl-score" aria-label="Rated {{ trip.totalBaked }} out of 55"><b>{{ trip.totalBaked }}</b><span>/55<small>rating</small></span></span>{%- endif %}<span class="sl-pto">{{ trip.pto.days }} PTO</span></div>
        <div class="sl-titlerow"><h3>{{ trip.displayName }}</h3><span class="sl-nights"><b>{{ trip.pto.nights }}</b><i>nights</i><span class="sl-away" title="+1 night in transit (red-eye/travel)">+1</span></span></div>
        <p class="sl-desc">{{ trip.cardSummary }}</p>
        <div class="sl-div"></div>
        <div class="sl-logi"><div><span class="lbl">Budget</span><br>{%- if trip.budget.ceilUsd <= 12000 %}<span class="sl-budget-pill target-fit" title="At or below the $12k target">{%- elif trip.budget.ceilUsd <= 15000 %}<span class="sl-budget-pill within-preference" title="Within the $15k preference">{%- else %}<span class="sl-budget-pill over-preference" title="Range crosses or exceeds the $15k preference">{%- endif %}${{ (trip.budget.floorUsd / 1000) | round(1) }}k–${{ (trip.budget.ceilUsd / 1000) | round(1) }}k</span></div><div><span class="lbl">Evidence</span><br>{{ trip.completeness.complete }}/{{ trip.completeness.total }} complete</div></div>
        <div class="sl-tags"><span>{{ trip.totalBaked }}/55</span><span>Fire {{ trip.display.fireChance }}</span><span>{{ trip.completeness.complete }}/{{ trip.completeness.total }} evidence</span>{%- if trip.budget.ceilUsd <= trip.budget.preferredMaxUsd %}<span>Within ${{ (trip.budget.preferredMaxUsd / 1000) | round(0) }}k preference</span>{%- endif %}</div>
        <div class="sl-readiness"><span class="lbl">Readiness</span><span>{{ trip.readiness.label }}</span></div>
        {%- if trip.short %}<div class="sl-meter done"><div class="sl-meter-head"><span class="sl-meter-label">✓ {{ trip.completeness.complete }}/{{ trip.completeness.total }} planning sections</span><span class="sl-score" aria-label="Rated {{ trip.totalBaked }} out of 55"><b>{{ trip.totalBaked }}</b><span>/55<small>rating</small></span></span></div><div class="sl-meter-bar"><span class="sl-meter-fill" style="width:100%"></span></div><small class="sl-evidence-freshness">{{ trip.evidence.overallConfidence }} evidence · reviewed {{ trip.evidence.reviewedAt | displayDate }}</small></div>{%- endif %}
      </div>
    </a>
{%- endmacro %}
