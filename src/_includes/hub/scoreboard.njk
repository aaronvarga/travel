{% for trip in hub.orderedTrips %}
      <tr data-trip="{{ trip.token }}" data-plane="{{ trip.metrics.airHours }}" data-car="{{ trip.metrics.groundHours }}">
        <th><span>{{ trip.displayName }}</span><small>{{ trip.blurb }}</small></th>
        <td><span class="wx-cell">{{ trip.budget.floorUsd | moneyK }}&ndash;{{ trip.budget.ceilUsd | moneyK }}</span><span class="rating" aria-label="{{ trip.axes.budget }} out of 5"></span><b>{{ trip.axes.budget }}</b></td>
        <td>{% if trip.display.weatherTempF %}<span class="wx-cell">{{ trip.display.weatherTempF[0] }}&ndash;{{ trip.display.weatherTempF[1] }}&deg;F</span>{% endif %}<span class="rating" aria-label="{{ trip.axes.weather }} out of 5"></span><b>{{ trip.axes.weather }}</b></td>
        <td><span class="wx-cell">{{ trip.display.swimTempF[0] }}&ndash;{{ trip.display.swimTempF[1] }}&deg;F</span><span class="rating" aria-label="{{ trip.axes.swim }} out of 5"></span><b>{{ trip.axes.swim }}</b></td>
        <td><span class="rating" aria-label="{{ trip.axes.variety }} out of 5"></span><b>{{ trip.axes.variety }}</b></td>
        <td><span class="ease-travel" title="Total flight time {{ trip.metrics.airHours }}h &middot; total ground time {{ trip.metrics.groundHours }}h">&#9992;&#65039; {{ trip.metrics.airHours | roundHours }}h<span class="tt-sep">/</span>&#128663; {{ trip.metrics.groundHours | roundHours }}h</span><span class="rating" aria-label="{{ trip.axes.ease }} out of 5"></span><b>{{ trip.axes.ease }}</b></td>
        <td><span class="rating" aria-label="{{ trip.axes.food }} out of 5"></span><b>{{ trip.axes.food }}</b></td>
        <td><span class="rating" aria-label="{{ trip.axes.risk }} out of 5"></span><b>{{ trip.axes.risk }}</b></td>
        <td><span class="rating" aria-label="{{ trip.axes.nights }} out of 5"></span><b>{{ trip.axes.nights }}</b></td>
        <td><span class="rating" aria-label="{{ trip.axes.novelty }} out of 5"></span><b>{{ trip.axes.novelty }}</b></td>
        <td class="pto-cell" title="{{ trip.pto.days }} PTO days / {{ trip.pto.nights }} hotel nights"><span class="wx-cell">{{ trip.pto.days }}d / {{ trip.pto.nights }}n</span></td>
        <td><b>{{ trip.totalBaked }}</b></td>
      </tr>
{% endfor %}
