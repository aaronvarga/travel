{%- from "hub/trip-card.njk" import tripCard %}
<section id="family-shortlist" class="shortlist">
  <div class="sl-head">
    <p class="sl-eyebrow">Your family shortlist</p>
    <h2>Short list</h2>
    <p>Sicily routes and Madeira–Mallorca, in the same order as the full trip list. The one-week Sicily option follows with its separate short-trip rank.</p>
  </div>
  <div class="sl-grid">
  {%- for trip in familyShortlist %}
    {{- tripCard(trip, true) }}
  {%- endfor %}
  </div>
</section>
