{%- set pointsPlan = capitalOnePoints.plans[trip.slug] -%}
{%- if trip.main.tripCategory != "short" and pointsPlan -%}
<style>
  .points-plan-grid{display:grid;grid-template-columns:minmax(0,1.15fr) minmax(280px,.85fr);gap:18px}
  .points-plan-hero,.points-plan-metrics article,.points-plan-actions article{border:1px solid var(--line);border-radius:14px;background:var(--card);box-shadow:0 12px 30px rgba(30,32,28,.1)}
  .points-plan-hero{position:relative;overflow:hidden;padding:24px;border-left:6px solid var(--c1)}
  .points-plan-hero::after{content:"200K";position:absolute;right:-8px;bottom:-30px;color:rgba(31,111,120,.07);font:800 5rem/1 "Fraunces","Georgia",serif;pointer-events:none}
  .points-plan-tag{display:inline-block;margin-bottom:8px;color:var(--c1);font-size:.7rem;font-weight:900;letter-spacing:.09em;text-transform:uppercase}
  .points-plan-hero h3,.points-plan-actions h3{margin:0 0 10px;font-size:1.2rem}
  .points-plan-hero p,.points-plan-actions p{position:relative;z-index:1;margin:8px 0 0;color:var(--muted);font-size:.9rem;line-height:1.55}
  .points-plan-hero strong,.points-plan-actions strong{color:var(--ink)}
  .points-plan-metrics{display:grid;gap:10px}
  .points-plan-metrics article{padding:16px 18px}
  .points-plan-metrics span{display:block;color:var(--muted);font-size:.69rem;font-weight:850;letter-spacing:.08em;text-transform:uppercase}
  .points-plan-metrics strong{display:block;margin-top:2px;color:var(--ink);font:700 1.45rem/1.2 "Fraunces","Georgia",serif}
  .points-plan-metrics p{margin:5px 0 0;color:var(--muted);font-size:.82rem;line-height:1.42}
  .points-plan-actions{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:18px;margin-top:18px}
  .points-plan-actions article{padding:20px 22px}
  .points-plan-actions ol{margin:0;padding-left:1.2rem;color:var(--muted);font-size:.87rem;line-height:1.5}
  .points-plan-actions li+li{margin-top:7px}
  .points-plan-sources{margin:14px 0 0;color:var(--muted);font-size:.76rem;line-height:1.5}
  .points-plan-sources a{color:var(--c1)}
  @media(max-width:820px){.points-plan-grid,.points-plan-actions{grid-template-columns:1fr}}
  @media print{.points-plan-hero,.points-plan-metrics article,.points-plan-actions article{box-shadow:none}}
</style>
<section id="capital-one-points" class="divider points-plan">
  <div class="section-label">
    <p class="eyebrow">200,000 Capital One Miles</p>
    <h2>Use the points where this trip is most expensive</h2>
    {% if pointsPlan.rankableStrategy %}<p>The ranking uses a fixed $2,000 eligible-travel credit. No transfer award or four-seat award availability is confirmed.</p>{% else %}<p>This is a booking target, not observed award availability. Search all four seats first, compare the same itinerary in cash, and transfer only when the complete award is ready to ticket.</p>{% endif %}
  </div>

{% if pointsPlan.rankableStrategy %}
  <div class="points-plan-grid">
    <article class="points-plan-hero"><span class="points-plan-tag">Defensible ranking strategy</span><h3>200,000 miles → $2,000 travel credit</h3><p>{{ pointsPlan.bookingCaveat }}</p><p>{{ pointsPlan.cashImpact }}</p><p><strong>No four-seat award is confirmed.</strong> Transfer opportunities below are unverified upside and contribute zero additional ranking savings.</p></article>
    <div class="points-plan-metrics">
      <article><span>Pay cash, retain all miles</span><strong>{{ pointsPlan.grossCashRangeUsd[0] | money }}–{{ pointsPlan.grossCashRangeUsd[1] | money }}</strong></article>
      <article><span>Net trip after fixed redemption</span><strong>{{ pointsPlan.netCashRangeUsd[0] | money }}–{{ pointsPlan.netCashRangeUsd[1] | money }}</strong><p>$2,000 savings · 1¢ per mile · 200,000 miles used</p></article>
      <article><span>Remaining airfare out of pocket</span><strong>{{ pointsPlan.remainingCashAirfareUsd[0] | money }}–{{ pointsPlan.remainingCashAirfareUsd[1] | money }}</strong><p>Cash airfare with its taxes/allowances, less the credit. No separate award charges because this is not an award booking.</p></article>
    </div>
  </div>
  <div class="points-plan-actions"><article><h3>Mixed cash and awards</h3><p>{{ pointsPlan.mixedStrategy }}</p></article><article><h3>Transfer timing and confidence</h3><p>{{ pointsPlan.transferTiming }}</p><p>{{ pointsPlan.availabilityConfidence }}</p></article></div>
  <details><summary>Airline partner screening — prices and seats are not confirmed</summary><div class="budget-scroll"><table class="budget-tbl"><tr><th>Program / ratio</th><th>Route relevance</th><th>Price and booking limits</th></tr>{% for candidate in pointsPlan.partnerComparisons %}<tr><td><a href="{{ candidate.sourceUrl }}" target="_blank" rel="noreferrer">{{ candidate.program }}</a><br>{{ candidate.ratio }}</td><td>{{ candidate.relevance }}</td><td>{{ candidate.pricing }} {{ candidate.availability }}. Exact award taxes, surcharges, bags, seats, cancellation and positioning totals remain unquoted.</td></tr>{% endfor %}</table></div></details>
  <p class="points-plan-sources">Checked {{ capitalOnePoints.asOf }}: {% for source in pointsPlan.supportingSources %}<a href="{{ source.url }}" target="_blank" rel="noreferrer">{{ source.label }}</a>{% if not loop.last %} · {% endif %}{% endfor %}</p>
{% else %}
  <div class="points-plan-grid">
    <article class="points-plan-hero">
      <span class="points-plan-tag">Best use for this route</span>
      <h3>{{ pointsPlan.route }}</h3>
      {%- if pointsPlan.strategy == "flying-blue-europe" %}
      <p><strong>Try Flying Blue first.</strong> The high-upside target is 25,000 miles per person each way in Economy Light. Eight one-way awards use all 200,000 miles and can cover the family round trip if every segment prices at that floor.</p>
      <p>Search the open jaw as separate one-ways, including PIT and sensible U.S. gateway starts. Compare Light, Standard and Flex conditions; taxes and carrier surcharges are paid in cash.</p>
      {%- elif pointsPlan.strategy == "aeroplan-california" %}
      <p><strong>Try Air Canada Aeroplan first for United space.</strong> The current 1,501–2,750-mile band starts at 12,500 points one way and has a 17,000-point median on Air Canada/select partners. Eight seats total would use roughly 100,000–136,000 points at those benchmarks.</p>
      <p>That leaves about 64,000–100,000 points for hotels, the rental car, or a later trip. Connections and peak dates can price higher.</p>
      {%- elif pointsPlan.strategy == "aeroplan-hawaii" %}
      <p><strong>Try Air Canada Aeroplan first for United space.</strong> The current 2,751+ mile North America band starts at 17,500 points one way and has a 22,900-point median on Air Canada/select partners. Eight seats total would use roughly 140,000–183,200 points at those benchmarks.</p>
      <p>That leaves about 16,800–60,000 points for inter-island travel, a hotel charge, or a later trip. Connections and peak dates can price higher.</p>
      {%- elif pointsPlan.strategy == "fixed-value" %}
      <p><strong>Use the fixed-value travel redemption first.</strong> This route's cash airfare is low enough that an airline transfer is unlikely to cover all eight family flight segments with 200,000 points.</p>
      <p>Pay for eligible travel with the card, then use miles against the charge at the current 1-cent travel rate. This preserves the cash itinerary and avoids award-seat compromises.</p>
      {%- elif pointsPlan.strategy == "hold-reroute" %}
      <p><strong>Do not transfer yet.</strong> The itinerary's current air construction is marked reroute-required. A speculative transfer would strand flexible points inside one airline program before the route is valid.</p>
      <p>Rebuild the flight chain first, then price Flying Blue and Aeroplan side by side for all four travelers.</p>
      {%- endif %}
    </article>

    <div class="points-plan-metrics" aria-label="Capital One points value comparison">
      <article><span>Cash-value floor</span><strong>$2,000</strong><p>200,000 miles at 1 cent each toward eligible travel.</p></article>
      <article><span>Transfer benchmark</span><strong>{{ capitalOnePoints.transferBenchmarkUsd }}</strong><p>Independent 1.6–1.85¢ valuations; useful as a hurdle, not a guarantee.</p></article>
      <article><span>This itinerary</span><strong>Airfare first</strong><p>{{ pointsPlan.cashImpact }}</p></article>
    </div>
  </div>

  <div class="points-plan-actions">
    <article>
      <h3>Booking sequence</h3>
      <ol>
        <li>Open free loyalty accounts for every program being compared; the Capital One and loyalty-account names must match.</li>
        <li>Search for four award seats on every required date and verify the final points, cash charges, bags, seats and change rules.</li>
        <li>Divide cash price minus unavoidable award charges by miles used. Transfer only when the result beats 1 cent per mile and the route remains protected.</li>
        <li>Transfer the exact amount only after the award is visible. Capital One transfers cannot be reversed.</li>
      </ol>
    </article>
    <article>
      <h3>Second search and fallback</h3>
      <p>{{ pointsPlan.backup }}</p>
      <p><strong>No worthwhile award?</strong> Keep the miles at Capital One and erase $2,000 of eligible flights, lodging, rental cars, rail, taxis or other qualifying travel after purchase. Never transfer merely because a temporary bonus appears.</p>
    </article>
  </div>

  <p class="points-plan-sources">Research checked {{ capitalOnePoints.asOf }}:
    <a href="{{ capitalOnePoints.sources.capitalOne.url }}" target="_blank" rel="noreferrer">{{ capitalOnePoints.sources.capitalOne.label }}</a> ·
    <a href="{{ capitalOnePoints.sources.fixedValue.url }}" target="_blank" rel="noreferrer">{{ capitalOnePoints.sources.fixedValue.label }}</a> ·
    <a href="{{ capitalOnePoints.sources.transferValue.url }}" target="_blank" rel="noreferrer">{{ capitalOnePoints.sources.transferValue.label }}</a>
    {%- if pointsPlan.strategy == "flying-blue-europe" %} · <a href="{{ capitalOnePoints.sources.flyingBlue.url }}" target="_blank" rel="noreferrer">{{ capitalOnePoints.sources.flyingBlue.label }}</a> · <a href="{{ capitalOnePoints.sources.flyingBlueFloor.url }}" target="_blank" rel="noreferrer">{{ capitalOnePoints.sources.flyingBlueFloor.label }}</a>{% endif %}
    {%- if pointsPlan.strategy == "aeroplan-california" or pointsPlan.strategy == "aeroplan-hawaii" or pointsPlan.strategy == "fixed-value" or pointsPlan.strategy == "hold-reroute" %} · <a href="{{ capitalOnePoints.sources.aeroplan.url }}" target="_blank" rel="noreferrer">{{ capitalOnePoints.sources.aeroplan.label }}</a>{% endif %}
    {%- if trip.slug == "hawaii" or trip.slug == "maui-kauai" or trip.slug == "turkish-riviera" %} · <a href="{{ capitalOnePoints.sources.turkish.url }}" target="_blank" rel="noreferrer">{{ capitalOnePoints.sources.turkish.label }}</a>{% endif %}
  </p>
{% endif %}
</section>
{%- endif -%}
