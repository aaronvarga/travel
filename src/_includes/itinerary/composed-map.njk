<section class="composer-map" id="map">
  <div class="section-label"><p class="eyebrow">Route map</p><h2>The composed route</h2><p>Destination and gateway points inherited from the source legs.</p></div>
  <div class="composer-map-grid">{% for point in combo.mapPoints %}<a href="{{ point.g | safe }}" target="_blank" rel="noreferrer"><strong>{{ point.n | safe }}</strong><span>{{ point.r | safe }}</span></a>{% endfor %}</div>
</section>
