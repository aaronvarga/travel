<section id="planning-variants" class="divider evidence-section">
  <div class="section-label"><p class="eyebrow">Ways to Take This Trip</p><h2>Choose the version that fits your family</h2><p>Start with the recommended itinerary, then compare any alternatives by time, cost, and what you would give up.</p></div>
  <div class="variant-grid">{%- for variant in trip.variants.variants -%}<article{% if variant.canonical %} class="canonical"{% endif %}><span>{% if variant.canonical %}Recommended{% else %}Alternative{% endif %}</span><h3>{{ variant.label }}</h3><p><strong>{{ variant.nights }} nights · {{ variant.ptoDays }} PTO</strong><br>{{ variant.budget.lowUsd | moneyK }}&ndash;{{ variant.budget.highUsd | moneyK }} estimated total</p><p>{{ variant.notes }}</p><small>Estimate confidence: {{ variant.confidence | default("unknown") | title }}</small>{% if variant.removedExperiences.length %}<small>Tradeoff: {{ variant.removedExperiences | join("; ") }}</small>{% endif %}</article>{%- endfor -%}</div>
  {%- if trip.variants.variants | length == 1 %}<p class="variant-note">This is the only version priced in detail. Other lengths can be explored once their savings and tradeoffs are clear.</p>{% endif %}
</section>
