{%- macro badge(kind, label) -%}<span class="verification-badge {{ kind }}">{{ label }}</span>{%- endmacro -%}
{%- macro empty(title, message) -%}<div class="verification-empty"><strong>{{ title }}</strong><p>{{ message }}</p></div>{%- endmacro -%}
{%- macro heading(eyebrow, title, description, kind, label) -%}<div class="section-label"><p class="eyebrow">{{ eyebrow }}</p><h2>{{ title }}{% if kind %} {{ badge(kind, label) }}{% endif %}</h2>{% if description %}<p>{{ description }}</p>{% endif %}</div>{%- endmacro -%}
